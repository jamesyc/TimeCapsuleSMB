	</dict>
	<key>backend.summary.migration.kept_not_visible</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@values@</string>
		<key>values</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Ook de Apple-firmware kan deze waarde niet opslaan, dus die blijft in de oude opslag en is niet zichtbaar via SMB; al het andere is gemigreerd.</string>
			<key>other</key>
			<string>Ook de Apple-firmware kan deze waarden niet opslaan, dus die blijven in de oude opslag en zijn niet zichtbaar via SMB; al het andere is gemigreerd.</string>
		</dict>
