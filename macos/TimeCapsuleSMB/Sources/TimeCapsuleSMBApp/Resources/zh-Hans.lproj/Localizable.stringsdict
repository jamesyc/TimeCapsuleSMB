<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>activity.multiple_active</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 个正在进行的操作</string>
	</dict>
	<key>backend.summary.discovered_devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>发现 %lld 个设备。</string>
	</dict>
	<key>backend.summary.flash.apple_some_match</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld/%2$lld 个候选固件区与苹果原厂固件匹配。</string>
	</dict>
	<key>backend.summary.flash.apple_some_match_version</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld/%2$lld 个候选固件区与苹果原厂固件 %3$@ 匹配。</string>
	</dict>
	<key>backend.summary.hfs_volumes_found</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>找到 %lld 个已挂载的 HFS 卷。</string>
	</dict>
	<key>backend.summary.repair_xattrs_found</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>发现 %lld 个元数据问题，其中 %lld 个可修复。</string>
	</dict>
	<key>backend.summary.repair_xattrs_no_safe_repairs</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>发现 %lld 个元数据问题，但没有已知的安全修复方法。</string>
	</dict>
	<key>backend.summary.repair_xattrs_unresolved</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>修复后仍有 %lld 个元数据问题。</string>
	</dict>
	<key>bundle_issue.distribution_artifacts_missing_count.message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>TimeCapsuleSMB 随附分发包缺少 %lld 个安装文件。</string>
	</dict>
</dict>
</plist>
