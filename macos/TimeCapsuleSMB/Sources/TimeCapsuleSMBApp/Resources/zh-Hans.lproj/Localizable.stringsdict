<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>activity.multiple_active</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 个正在进行的操作</string>
	</dict>
	<key>backend.summary.discovered_devices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>发现 %lld 个设备。</string>
	</dict>
	<key>backend.summary.flash.apple_some_match</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$lld 个候选固件区中有 %1$lld 个与苹果原厂固件匹配。</string>
	</dict>
	<key>backend.summary.flash.apple_some_match_version</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$lld 个候选固件区中有 %1$lld 个与苹果原厂固件 %3$@ 匹配。</string>
	</dict>
	<key>backend.summary.hfs_volumes_found</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>找到 %lld 个已挂载的 HFS 卷。</string>
	</dict>
	<key>backend.summary.migration.kept_folder_fork</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>  %1$@（文件夹资源分叉，%2$lld 字节）</string>
	</dict>
	<key>backend.summary.migration.kept_folder_forks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 个文件夹带有资源分叉，而 HFS 文件夹无法存储资源分叉。</string>
	</dict>
	<key>backend.summary.migration.kept_in_appledouble</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>其中 %lld 个值位于已保留的 ._ 文件中。</string>
	</dict>
	<key>backend.summary.migration.kept_in_database_in_place</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>其中 %lld 个值位于旧版 Samba 数据库中，该数据库会保留在原处，直到所有磁盘上的迁移都完成。</string>
	</dict>
	<key>backend.summary.migration.kept_in_database_quarantined</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>其中 %lld 个值位于旧版 Samba 数据库中，该数据库已保留为 xattr.tdb.orphaned.N，而未被删除。</string>
	</dict>
	<key>backend.summary.migration.kept_more</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>  ...另有 %lld 个</string>
	</dict>
	<key>backend.summary.migration.kept_not_visible</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@values@</string>
		<key>values</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>苹果固件同样无法存储此类值，因此将其保留在旧版存储中，无法通过 SMB 查看；其余内容均已迁移。</string>
		</dict>
	</dict>
	<key>backend.summary.migration.kept_too_large</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 个 Mac 元数据值超出了 HFS 原生属性的容量上限（3,802 字节）。</string>
	</dict>
	<key>backend.summary.migration.kept_value</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>  %1$@（%2$@，%3$lld 字节）</string>
	</dict>
	<key>backend.summary.migration.skipped_malformed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 个 ._ 文件已损坏，已原样保留。</string>
	</dict>
	<key>backend.summary.migration.skipped_more</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>  ...另有 %lld 个</string>
	</dict>
	<key>backend.summary.migration.skipped_name_too_long</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 个文件的名称过长，此设备上的 Samba 无法打开，因此无法通过 SMB 看到。要访问这些文件，请将磁盘连接到 Mac。</string>
	</dict>
	<key>backend.summary.migration.skipped_not_a_file</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 个 ._ 项目不是普通文件，已保留。</string>
	</dict>
	<key>backend.summary.migration.skipped_unsupported</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 个 ._ 文件包含 TimeCapsuleSMB 不转换的条目。其中受支持的元数据已迁移，文件已保留。</string>
	</dict>
	<key>bundle_issue.distribution_artifacts_missing_count.message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>TimeCapsuleSMB 随附分发包缺少 %lld 个安装文件。</string>
	</dict>
</dict>
</plist>
