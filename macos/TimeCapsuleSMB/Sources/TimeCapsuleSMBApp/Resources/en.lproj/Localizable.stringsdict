		<key>values</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Mac metadata value is larger than a native HFS attribute can hold (3,802 bytes).</string>
			<key>other</key>
			<string>%lld Mac metadata values are larger than a native HFS attribute can hold (3,802 bytes).</string>
		</dict>
	</dict>
	<key>backend.summary.migration.kept_value</key>
