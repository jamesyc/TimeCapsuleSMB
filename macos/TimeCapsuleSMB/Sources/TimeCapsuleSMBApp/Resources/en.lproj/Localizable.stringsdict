			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>  ...and %lld more</string>
			<key>other</key>
			<string>  ...and %lld more</string>
		</dict>
	</dict>
	<key>backend.summary.migration.kept_not_visible</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@values@</string>
		<key>values</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Apple's firmware cannot store it either, so it stays in legacy storage and is not visible over SMB; everything else was migrated.</string>
			<key>other</key>
			<string>Apple's firmware cannot store them either, so they stay in legacy storage and are not visible over SMB; everything else was migrated.</string>
		</dict>
	</dict>
	<key>backend.summary.migration.kept_too_large</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
