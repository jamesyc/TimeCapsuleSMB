"backend.recovery.disk_not_responding.action.4" = "Substitua o disco.";
"backend.recovery.disk_not_responding.action.5" = "Apague o disco novo no Utilitário AirPort e depois execute “Instalar/atualizar Samba”. O Time Machine começa nele um backup novo e completo.";
