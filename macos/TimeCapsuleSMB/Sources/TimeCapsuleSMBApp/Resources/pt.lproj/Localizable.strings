"backend.recovery.fsck_already_running.action.1" = "Mantenha o dispositivo ligado na tomada e aguarde. Em um disco grande, a análise pode levar uma hora ou mais.";
"backend.recovery.fsck_already_running.action.2" = "Depois, tente novamente.";
"backend.recovery.disk_seagate_failed.title" = "O disco Seagate falhou";
"backend.recovery.disk_seagate_failed.message" = "O disco interno informa que tem 3,86 GB. Um disco Seagate faz isso quando não consegue carregar o próprio firmware, geralmente porque os cabeçotes ou a área do firmware falharam. Reiniciar ou reinstalar não vai resolver isso, e o dispositivo não consegue ler os arquivos dele.";
"backend.recovery.disk_seagate_failed.action.1" = "Se você precisar dos arquivos dele, não apague o disco: um serviço de recuperação de dados talvez consiga recuperá-los. Outros usuários descrevem a mesma falha no Tom's Hardware (https://forums.tomshardware.com/threads/seagate-1tb-st1000vm002-unallocated-3-86-gb.3657800/).";
"backend.recovery.disk_seagate_failed.action.2" = "Substitua o disco (guia de substituição: https://github.com/jamesyc/TimeCapsuleSMB/blob/main/FAQ.md#a-seagate-disk-reports-386-gb).";
"backend.recovery.disk_seagate_failed.action.3" = "Apague o disco novo no Utilitário AirPort e depois execute “Instalar/atualizar Samba”. O Time Machine começa nele um backup novo e completo.";
"backend.recovery.disk_size_misreported.title" = "O disco está informando o tamanho errado";
"backend.recovery.disk_size_misreported.message" = "O dispositivo informa que o disco interno é muito menor do que é. Às vezes uma reinicialização resolve isso; se continuar acontecendo, o disco provavelmente está falhando.";
