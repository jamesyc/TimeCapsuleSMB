"backend.recovery.wifi_link_slow.title" = "O dispositivo não respondeu a tempo pelo Wi-Fi";
"backend.recovery.wifi_link_slow.message" = "O dispositivo se conecta à sua rede por Wi-Fi em vez de um cabo Ethernet e não respondeu a tempo. Uma conexão Wi-Fi lenta pode causar isso.";
"backend.recovery.wifi_link_slow.action.1" = "Reinicie o dispositivo e tente novamente: ele entra de novo na rede Wi-Fi, o que pode deixar a conexão mais rápida.";
"backend.recovery.wifi_link_slow.action.2" = "Se o tempo esgotar de novo, conecte este Mac com um cabo a uma das portas LAN do dispositivo e tente novamente.";
"backend.recovery.wifi_link_slow.action.3" = "Ou tente novamente mais tarde: a conexão costuma voltar a ficar rápida em poucas horas.";
"backend.recovery.wifi_link_slow.action.4" = "Para uma solução duradoura, conecte o dispositivo ao seu roteador com um cabo Ethernet e, no Utilitário AirPort, mude o modo sem fio dele para que não entre mais em outra rede.";
"backend.recovery.acpd_broken.title" = "O Apple ACPd não está funcionando";
"backend.recovery.acpd_broken.message" = "O serviço AirPort da Apple (ACPd) está travado ou não está mais em execução no dispositivo. Este é um erro no firmware da Apple, não no TimeCapsuleSMB.";
"backend.recovery.acpd_broken.action.1" = "Desconecte o dispositivo, aguarde 10 segundos e conecte-o novamente.";
"backend.recovery.acpd_broken.action.2" = "Aguarde 2 minutos até o dispositivo iniciar e tente novamente.";
"backend.recovery.acpd_network_silent.title" = "Sem resposta do Apple ACPd pela rede";
"backend.recovery.acpd_network_silent.message" = "O dispositivo não respondeu a uma leitura do AirPort ACP, nem deste Mac nem pelo SSH. Ou a conexão com o dispositivo está lenta demais, ou o dispositivo está com arquivos abertos demais (vários Macs conectados ao mesmo tempo podem causar isso), ou o serviço AirPort da Apple (ACPd) não responde mais à rede (um bug no firmware da Apple). O compartilhamento de arquivos pode ainda funcionar. Nada foi alterado.";
"backend.recovery.acpd_network_silent.action.1" = "Se a conexão com o dispositivo puder estar lenta, como uma conexão Wi-Fi fraca, tente novamente por Ethernet.";
"backend.recovery.acpd_network_silent.action.2" = "Caso contrário, tente desconectar o dispositivo da tomada por 10 segundos, conectá-lo de novo e aguardar 2 minutos.";
"backend.recovery.acpd_quit.title" = "O Apple ACPd parou";
"backend.recovery.acpd_quit.message" = "O serviço AirPort da Apple (ACPd) parou no dispositivo e só volta a iniciar quando o dispositivo reiniciar. Sem ele, o compartilhamento de arquivos não pode iniciar e o dispositivo não pode ser atualizado nem reiniciado pela rede. Este é um erro no firmware da Apple, não no TimeCapsuleSMB.";
"backend.recovery.acpd_quit.action.1" = "Desconecte o dispositivo, aguarde 10 segundos e conecte-o novamente.";
"backend.recovery.acpd_quit.action.2" = "Aguarde 2 minutos até o dispositivo iniciar e execute “Verificação”.";
"backend.recovery.acpd_quit.action.3" = "Em dispositivos NetBSD 4, execute “Ativar” se a verificação mostrar que o Samba não está em execução.";
