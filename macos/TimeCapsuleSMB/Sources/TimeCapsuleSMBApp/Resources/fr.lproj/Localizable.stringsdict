		</dict>
	</dict>
	<key>backend.summary.flash.apple_some_match</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld des %2$lld banques de firmware candidates %1$#@verb@ au firmware d’origine Apple.</string>
		<key>verb</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>correspondent</string>
			<key>one</key>
			<string>correspond</string>
			<key>other</key>
			<string>correspondent</string>
		</dict>
	</dict>
	<key>backend.summary.flash.apple_some_match_version</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld des %2$lld banques de firmware candidates %1$#@verb@ au firmware d’origine Apple %3$@.</string>
		<key>verb</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
