"doctor.check.payload_missing_from_disk" = "Visuose diskuose trūksta Samba diegimo failų, pavyzdžiui, po disko ištrynimo su AirPort Utility (Erase Disk). Paleiskite „Įdiegti / atnaujinti Samba“, kad įdiegtumėte iš naujo.";
"doctor.check.payload_damaged_on_disk" = "Samba diegimo failai diske sugadinti ir nebesutampa su tuo, kas buvo įdiegta. Paleiskite „Įdiegti / atnaujinti Samba“, kad įdiegtumėte iš naujo.";
"doctor.check.payload_unreadable_on_disk" = "Įrenginio diskas negalėjo nuskaityti Samba diegimo failų arba skaitė juos per lėtai, todėl jis greičiausiai genda, o failų bendrinimas sustabdytas. Įdiegimas iš naujo disko nesutaisys, o AirPort Utility jį vis dar gali rodyti kaip tvarkingą. Nukopijuokite reikalingus failus, pakeiskite diską, tada AirPort Utility ištrinkite naująjį diską ir paleiskite „Įdiegti / atnaujinti Samba“.";
"doctor.check.rsync_missing_from_disk" = "rsync failų diske nėra, todėl rsync išjungtas. Failų bendrinimas ir Time Machine toliau veikia. Paleiskite „Įdiegti / atnaujinti Samba“, kad įdiegtumėte iš naujo.";
"doctor.check.rsync_damaged_on_disk" = "rsync failas diske sugadintas ir nebesutampa su tuo, kas buvo įdiegta, todėl rsync išjungtas. Failų bendrinimas ir Time Machine toliau veikia. Paleiskite „Įdiegti / atnaujinti Samba“, kad įdiegtumėte iš naujo.";
"doctor.check.rsync_unreadable_on_disk" = "Įrenginio diskas negalėjo nuskaityti rsync failo arba skaitė jį per lėtai, todėl rsync išjungtas, o diskas greičiausiai genda. Failų bendrinimas ir Time Machine kol kas veikia. Įdiegimas iš naujo disko nesutaisys: nukopijuokite reikalingus failus, pakeiskite diską, tada AirPort Utility ištrinkite naująjį diską ir paleiskite „Įdiegti / atnaujinti Samba“.";
"doctor.check.metadata_migration_in_progress" = "Įrenginyje vis dar vyksta metaduomenų perkėlimas. Paleidus „Įdiegti / atnaujinti Samba“, diegimas palauks, kol jis baigsis.";
"doctor.check.disk_not_mounting" = "Nepavyksta prijungti įrenginio disko, todėl failų bendrinimas ir Time Machine neveikia. Paleiskite įrenginį iš naujo; jei jis neatsiranda, 10 sekundžių atjunkite jį nuo maitinimo. Jei diskas vis tiek neprijungiamas, paleiskite operaciją „Disko taisymas“; jei tai kartojasi, diską gali reikėti pakeisti.";
"doctor.check.disk_size_misreported" = "Įrenginys praneša, kad jo vidinis diskas daug mažesnis, nei yra iš tikrųjų, todėl į jį nieko negalima įdiegti. Paleiskite įrenginį iš naujo; jei diskas ir toliau praneša neteisingą dydį, jį reikia pakeisti.";
"doctor.check.disk_no_hfs_partition" = "Viename įrenginio diske nėra HFS tomo, kurį galėtų naudoti TimeCapsuleSMB. Jei tai vidinis diskas ir jame nėra nieko, ko jums reikia, naudokite „Performatuoti vidinį diską“, kad suformatuotumėte jį įrenginiui.";
"doctor.check.disk_volumes_in_memory" = "Vienas įrenginio tomas egzistuos tik iki kito paleidimo iš naujo: AirPort Utility komanda „Erase Disk“ negalėjo pakeisti jo disko skaidinių lentelės. Viskas, kas jame išsaugota nuo to ištrynimo, įskaitant Time Machine atsargines kopijas, bus prarasta per kitą paleidimą iš naujo. Nukopijuokite viską, ko jums reikia, kol įrenginys dar nepaleistas iš naujo. Tada, jei tai vidinis diskas, paleiskite „Performatuoti vidinį diską“; USB diską ištraukite iš įrenginio ir, prieš vėl jį įkišdami, ištrinkite jį Mac kompiuteryje su Disk Utility kaip „Mac OS Extended (Journaled)“.";
"doctor.check.acpd_gone" = "Apple AirPort tarnyba (ACPd) įrenginyje sustojo. Atjunkite įrenginį, palaukite 10 sekundžių, tada vėl prijunkite.";
"doctor.check.disk_failing" = "Įrenginio diskas pranešė apie klaidas, kurių nepavyko ištaisyti, todėl jis greičiausiai genda, o failų bendrinimas sustabdytas. Įdiegimas iš naujo disko nesutaisys, o AirPort Utility jį vis dar gali rodyti kaip tvarkingą. Nukopijuokite reikalingus failus, pakeiskite diską, tada AirPort Utility ištrinkite naująjį diską ir paleiskite „Įdiegti / atnaujinti Samba“.";
"doctor.check.disk_not_responding" = "Vienas iš įrenginio diskų nebeatsako: disko operacija jau kelias minutes laukia ir nesibaigia, o Apple AirPort tarnyba taip pat laukia disko. Atjunkite įrenginį, palaukite 10 sekundžių, tada vėl prijunkite. Jei diskas vėl nustos atsakyti, jis greičiausiai genda: nukopijuokite reikalingus failus, pakeiskite diską, tada AirPort Utility ištrinkite naująjį diską ir paleiskite „Įdiegti / atnaujinti Samba“.";
"doctor.check.client_on_unshared_network" = "Šis Mac yra tinkle, kuriame įrenginys nebendrina savo diskų, pavyzdžiui, įrenginio interneto (WAN) pusėje arba svečių tinkle. Prijunkite šį Mac prie pagrindinio įrenginio tinklo per Wi-Fi arba vieną iš jo LAN prievadų ir dar kartą paleiskite operaciją „Patikrinimas“.";
"doctor.check.mac_smb3_disabled" = "%@ išjungia SMB 3 (protocol_vers_map), o Time Machine reikia SMB 3. Ištrinkite tą eilutę, tada Time Machine nustatymuose pašalinkite diską ir pridėkite jį iš naujo.";
"doctor.check.mac_smb3_disabled_for_server" = "%1$@ išjungia SMB 3 serveriui [%2$@]. Jei tai šis įrenginys, ištrinkite tą eilutę, tada Time Machine nustatymuose pašalinkite diską ir pridėkite jį iš naujo.";
"doctor.check.ssh_disabled" = "Šiame įrenginyje SSH išjungta.";
"doctor.check.device_unreachable" = "Įrenginys neatsako nei per SSH, nei per AirPort ACP.";
