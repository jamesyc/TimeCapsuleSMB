			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>%lld di file hanno nomi troppo lunghi perché Samba possa aprirli su questo dispositivo, quindi non sono visibili tramite SMB. Per raggiungerli, collega il disco a un Mac.</string>
			<key>one</key>
