	<key>backend.summary.migration.kept_not_visible</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@values@</string>
		<key>values</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>Nemmeno il firmware Apple può memorizzarli, quindi restano nel formato di archiviazione precedente e non sono visibili tramite SMB; tutto il resto è stato migrato.</string>
			<key>one</key>
			<string>Nemmeno il firmware Apple può memorizzarlo, quindi resta nel formato di archiviazione precedente e non è visibile tramite SMB; tutto il resto è stato migrato.</string>
			<key>other</key>
