+/*
+ * Time Capsule native links (patch 0045): symlinks are objects clients see,
+ * so their names need the same mapping as every other at-call. Without it a
+ * link named with a mapped character (':' '*' '?' ...) is created correctly
+ * but its target can never be read back.
+ */
+static struct smb_filename *catia_map_at_name(vfs_handle_struct *handle,
+					      const struct smb_filename *in)
+{
+	struct smb_filename *out = NULL;
+	char *name = NULL;
+	int ret;
+
+	ret = catia_string_replace_allocate(handle->conn,
+					    in->base_name,
+					    &name,
+					    vfs_translate_to_unix);
+	if (ret != 0) {
+		errno = ret;
+		return NULL;
+	}
+	out = cp_smb_filename(talloc_tos(), in);
+	if (out == NULL) {
+		TALLOC_FREE(name);
+		errno = ENOMEM;
+		return NULL;
+	}
+	TALLOC_FREE(out->base_name);
+	out->base_name = talloc_move(out, &name);
+	out->fsp = in->fsp;
+	return out;
+}
+
+static int catia_symlinkat(vfs_handle_struct *handle,
+			   const struct smb_filename *link_contents,
+			   struct files_struct *dirfsp,
+			   const struct smb_filename *new_smb_fname)
+{
+	struct catia_cache *cc = NULL;
+	struct smb_filename *mapped = NULL;
+	int ret;
+
+	ret = CATIA_FETCH_FSP_PRE_NEXT(talloc_tos(), handle, dirfsp, &cc);
+	if (ret != 0) {
+		return ret;
+	}
+	mapped = catia_map_at_name(handle, new_smb_fname);
+	if (mapped == NULL) {
+		ret = -1;
+		goto out;
+	}
+	ret = SMB_VFS_NEXT_SYMLINKAT(handle, link_contents, dirfsp, mapped);
+	TALLOC_FREE(mapped);
+out:
+	CATIA_FETCH_FSP_POST_NEXT(&cc, dirfsp);
+	return ret;
+}
+
+static int catia_readlinkat(vfs_handle_struct *handle,
+			    const struct files_struct *dirfsp,
+			    const struct smb_filename *smb_fname,
+			    char *buf,
+			    size_t bufsiz)
+{
+	struct files_struct *dir = discard_const_p(struct files_struct, dirfsp);
+	struct catia_cache *cc = NULL;
+	struct smb_filename *mapped = NULL;
+	int ret;
+
+	ret = CATIA_FETCH_FSP_PRE_NEXT(talloc_tos(), handle, dir, &cc);
+	if (ret != 0) {
+		return ret;
+	}
+	mapped = catia_map_at_name(handle, smb_fname);
+	if (mapped == NULL) {
+		ret = -1;
+		goto out;
+	}
+	ret = SMB_VFS_NEXT_READLINKAT(handle, dirfsp, mapped, buf, bufsiz);
+	TALLOC_FREE(mapped);
+out:
+	CATIA_FETCH_FSP_POST_NEXT(&cc, dir);
+	return ret;
+}
