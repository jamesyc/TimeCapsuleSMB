+#define TC_APPLE_STREAM_XATTR_PREFIX "user.DosStream."
+#define TC_APPLE_STREAM_XATTR_SUFFIX ":$DATA"
+#define TC_FINDERINFO_XATTR "com.apple.FinderInfo"
+#define TC_RESOURCEFORK_XATTR "com.apple.ResourceFork"
