diff --git a/source3/rpc_server/srv_pipe_hnd.c b/source3/rpc_server/srv_pipe_hnd.c
--- a/source3/rpc_server/srv_pipe_hnd.c
+++ b/source3/rpc_server/srv_pipe_hnd.c
@@ -136,6 +136,10 @@ NTSTATUS np_wait_exists_recv(struct tevent_req *req)
 	return tevent_req_simple_recv_ntstatus(req);
 }
 
+#ifdef TC_SAMBA4X_EMBEDDED_SRVSVC
+#include "tc_embedded_srvsvc.c"
+#endif
+
 NTSTATUS np_open(TALLOC_CTX *mem_ctx, const char *name,
 		 const struct tsocket_address *remote_client_address,
 		 const struct tsocket_address *local_server_address,
@@ -147,6 +151,9 @@ NTSTATUS np_open(TALLOC_CTX *mem_ctx, const char *name,
 	struct fake_file_handle *handle;
 	struct npa_state *npa = NULL;
 	int ret;
+#ifdef TC_SAMBA4X_EMBEDDED_SRVSVC
+	NTSTATUS status;
+#endif
 
 	handle = talloc(mem_ctx, struct fake_file_handle);
 	if (handle == NULL) {
@@ -163,6 +170,28 @@ NTSTATUS np_open(TALLOC_CTX *mem_ctx, const char *name,
 		.private_data = npa,
 	};
 
+#ifdef TC_SAMBA4X_EMBEDDED_SRVSVC
+	status = tc_smbd_open_embedded_srvsvc_np(
+		name,
+		remote_client_address,
+		local_server_address,
+		session_info,
+		ev_ctx,
+		msg_ctx,
+		global_dcesrv_context(),
+		npa);
+	if (NT_STATUS_IS_OK(status)) {
+		*phandle = handle;
+		return NT_STATUS_OK;
+	}
+	if (!NT_STATUS_EQUAL(status, NT_STATUS_OBJECT_NAME_NOT_FOUND)) {
+		DBG_DEBUG("Embedded srvsvc pipe open failed: %s\n",
+			  nt_errstr(status));
+		TALLOC_FREE(handle);
+		return status;
+	}
+#endif
+
 	ret = local_np_connect(
 		name,
 		NCACN_NP,
diff --git a/source3/rpc_server/srvsvc/srv_srvsvc_nt.c b/source3/rpc_server/srvsvc/srv_srvsvc_nt.c
--- a/source3/rpc_server/srvsvc/srv_srvsvc_nt.c
+++ b/source3/rpc_server/srvsvc/srv_srvsvc_nt.c
@@ -657,19 +657,22 @@ static WERROR init_srv_share_info_ctr(struct pipes_struct *p,
 	DEBUG(5,("init_srv_share_info_ctr\n"));
 
 	/*
-	 * We need to make sure to reload the services for the connecting user.
-	 * It is possible that we have includes with substitutions.
-	 *
-	 *  include = /etc/samba/%U.conf
+	 * smbd serves this pipe in the worker that holds the client's trees
+	 * (tc_embedded_srvsvc.c), so this share table is live. Modules set
+	 * options on it in memory at tree connect, such as fruit's "posix
+	 * locking = no", and open files depend on them: a lock taken under
+	 * one value and released under the other panics or leaves a POSIX
+	 * lock that blocks this worker's own flock(). Stock Samba runs
+	 * lp_kill_all_services() and lp_load_with_shares() here for "include =
+	 * /etc/samba/%U.conf", in rpcd_classic, which holds no trees. The
+	 * appliance's smb.conf has no includes, and this worker already
+	 * follows smb.conf (MSG_SMB_CONF_UPDATED, check_reload()).
 	 *
 	 * We also need all printers and usershares.
 	 *
-	 * We need to be root in order to have access to registry shares
-	 * and root only smb.conf files.
+	 * We need to be root in order to have access to registry shares.
 	 */
 	become_root();
-	lp_kill_all_services();
-	lp_load_with_shares(get_dyn_CONFIGFILE());
 	delete_and_reload_printers();
 	load_usershare_shares(NULL, connections_snum_used);
 	load_registry_shares();
