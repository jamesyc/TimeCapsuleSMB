+/*
+ * With aio_fork:max_children helpers busy, requests wait in a short FIFO.
+ * Past this bound a request runs synchronously in the client's own smbd,
+ * which slows that client down instead of failing its I/O.
+ *
+ * Only aio_fork_send (for a request queued alone) and the event loop
+ * (aio_fork_kick) run the FIFO: freeing, completing or failing a request never
+ * dispatches or completes another. A request freed while its helper works
+ * leaves the helper busy until it replies; the reply is dropped and the helper
+ * reused, not killed (retired only if that reply read fails).
+ */
+#define AIO_FORK_MAX_PENDING 16
+
+/*
+ * Every helper gets one shared buffer of this size when it is forked, and
+ * all data passes through it. Requests larger than the buffer are refused,
+ * so it must cover the largest SMB2 read or write (Samba's default 8 MiB).
+ * Pages are only allocated once touched; aio_fork:max_children bounds the
+ * number of helpers per tree connection.
+ */
+#define AIO_FORK_BUFFER_SIZE (8 * 1024 * 1024)
