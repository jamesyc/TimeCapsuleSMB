+/* Run one command; -1 leaves errno set. */
+static ssize_t aio_fork_do_io(enum cmd_type cmd, int fd, void *buf,
+			      size_t n, off_t offset)
+{
+	switch (cmd) {
+	case READ_CMD:
+		return sys_pread_full(fd, buf, n, offset);
+	case PWRITE_CMD:
+		return sys_pwrite_full(fd, buf, n, offset);
+	case WRITE_CMD:
+		return sys_write_full(fd, buf, n);
+	case FSYNC_CMD:
+		return fsync(fd);
+	}
+	errno = EINVAL;
+	return -1;
+}
