diff --git a/source3/lib/dumpcore.c b/source3/lib/dumpcore.c
--- a/source3/lib/dumpcore.c
+++ b/source3/lib/dumpcore.c
@@ -56,11 +56,27 @@ static char *get_default_corepath(const char *logbase, const char *progname)
 		return NULL;
 	}
 
+#ifdef TC_SAMBA4X_APPLIANCE
+	/*
+	 * Time Capsule payload logs live on Apple-managed HFS. NetBSD4/6 HFS
+	 * reports root-created directories there with uid 4294967295, and the
+	 * firmware does not provide chown. The strict owner check rejects an
+	 * otherwise usable core directory and leaves smbd with no corepath.
+	 * Keep the mode request, but accept the HFS ownership model for this
+	 * appliance-only static build so panic cores land under the payload logs.
+	 */
+	if (!directory_create_or_exist(tmp_corepath, mode)) {
+		DEBUG(0, ("Failed to create %s with mode 0%o\n",
+			  tmp_corepath, (int)mode));
+		goto err_out;
+	}
+#else
 	if (!directory_create_or_exist_strict(tmp_corepath, uid, mode)) {
 		DEBUG(0, ("Failed to create %s for user %d with mode 0%o\n",
 			  tmp_corepath, (int)uid, (int)mode));
 		goto err_out;
 	}
+#endif
 
 	/* Setup progname-specific core subdir */
 	tmp_corepath = talloc_asprintf_append(tmp_corepath, "/%s", progname);
diff --git a/source3/lib/system.c b/source3/lib/system.c
--- a/source3/lib/system.c
+++ b/source3/lib/system.c
@@ -269,6 +269,28 @@ void copy_stat_ex_timestamps(struct stat_ex *st,
 	}
 }
 
+#ifdef TC_SAMBA4X_APPLIANCE
+static void tc_normalize_hfs_unknown_owner(struct stat_ex *st)
+{
+	/*
+	 * AirPort Time Capsule HFS can report absent catalog owner/group IDs
+	 * as 0xffffffff. Samba treats those values as real Unix IDs and later
+	 * tries to map them to SIDs in ACL, create-context, durable-handle, and
+	 * stream metadata paths. The appliance serves all SMB users through a
+	 * forced root/wheel identity, so normalize only this HFS sentinel before
+	 * it escapes the stat conversion boundary. See
+	 * https://github.com/jamesyc/TimeCapsuleSMB/issues/170.
+	 */
+	if (st->st_ex_uid == (uid_t)-1) {
+		st->st_ex_uid = 0;
+	}
+
+	if (st->st_ex_gid == (gid_t)-1) {
+		st->st_ex_gid = 0;
+	}
+}
+#endif
+
 void init_stat_ex_from_stat (struct stat_ex *dst,
 			    const struct stat *src,
 			    bool fake_dir_create_times)
@@ -279,6 +301,9 @@ void init_stat_ex_from_stat (struct stat_ex *dst,
 	dst->st_ex_nlink = src->st_nlink;
 	dst->st_ex_uid = src->st_uid;
 	dst->st_ex_gid = src->st_gid;
+#ifdef TC_SAMBA4X_APPLIANCE
+	tc_normalize_hfs_unknown_owner(dst);
+#endif
 	dst->st_ex_rdev = src->st_rdev;
 	dst->st_ex_size = src->st_size;
 	dst->st_ex_atime = get_atimespec(src);
