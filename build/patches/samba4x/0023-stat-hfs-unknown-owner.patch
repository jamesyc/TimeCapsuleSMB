diff --git a/source3/lib/dumpcore.c b/source3/lib/dumpcore.c
--- a/source3/lib/dumpcore.c
+++ b/source3/lib/dumpcore.c
@@ -56,11 +56,26 @@ static char *get_default_corepath(const char *logbase, const char *progname)
 		return NULL;
 	}
 
+#ifdef TC_SAMBA4X_APPLIANCE
+	/*
+	 * The logs live on the device's HFS, which reports a directory root
+	 * created as owned by uid 4294967295, and the firmware has no chown:
+	 * the strict owner check would leave smbd with no core path. The
+	 * non-strict create still asks mkdir for 0700 but skips the owner and
+	 * mode checks on an existing directory.
+	 */
+	if (!directory_create_or_exist(tmp_corepath, mode)) {
+		DEBUG(0, ("Failed to create %s with mode 0%o\n",
+			  tmp_corepath, (int)mode));
+		goto err_out;
+	}
+#else
 	if (!directory_create_or_exist_strict(tmp_corepath, uid, mode)) {
 		DEBUG(0, ("Failed to create %s for user %d with mode 0%o\n",
 			  tmp_corepath, (int)uid, (int)mode));
 		goto err_out;
 	}
+#endif
 
 	/* Setup progname-specific core subdir */
 	tmp_corepath = talloc_asprintf_append(tmp_corepath, "/%s", progname);
diff --git a/source3/lib/system.c b/source3/lib/system.c
--- a/source3/lib/system.c
+++ b/source3/lib/system.c
@@ -279,6 +279,20 @@ void init_stat_ex_from_stat (struct stat_ex *dst,
 	dst->st_ex_nlink = src->st_nlink;
 	dst->st_ex_uid = src->st_uid;
 	dst->st_ex_gid = src->st_gid;
+#ifdef TC_SAMBA4X_APPLIANCE
+	/*
+	 * HFS on the device reports a missing owner or group as 0xffffffff,
+	 * which no SID maps to in the ACL, create context and durable handle
+	 * paths. The appliance serves every user as root/wheel: take the
+	 * sentinel for that.
+	 */
+	if (dst->st_ex_uid == (uid_t)-1) {
+		dst->st_ex_uid = 0;
+	}
+	if (dst->st_ex_gid == (gid_t)-1) {
+		dst->st_ex_gid = 0;
+	}
+#endif
 	dst->st_ex_rdev = src->st_rdev;
 	dst->st_ex_size = src->st_size;
 	dst->st_ex_atime = get_atimespec(src);
