 }
 
+#ifndef HAVE_PTHREAD
+static void smbd_child_detach_parent(struct smbd_parent_context *parent)
+{
+	struct smbd_open_socket *listener;
+
+	/*
+	 * The appliance child is still inside a listener callback. Recursively
+	 * freeing the copied parent tree here has aborted while following one
+	 * of its talloc reference handles. The child only needs to release its
+	 * inherited listeners; reinit_after_fork() disarms the copied events
+	 * and signals, and process exit reclaims this private allocation tree.
+	 */
+	for (listener = parent->sockets; listener != NULL;
+	     listener = listener->next) {
+		/* No later destructor may close a descriptor reused by the child. */
+		tevent_fd_set_close_fn(listener->fde, NULL);
+		close(listener->fd);
+		listener->fd = -1;
+	}
+	talloc_steal(NULL, parent);
+}
+#endif
+
 static void smbd_accept_connection(struct tevent_context *ev,
 				   struct tevent_fd *fde,
 				   uint16_t flags,
