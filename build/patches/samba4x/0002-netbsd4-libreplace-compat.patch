diff --git a/lib/replace/replace.c b/lib/replace/replace.c
--- a/lib/replace/replace.c
+++ b/lib/replace/replace.c
@@ -45,6 +45,10 @@
 #define mkdir(d,m) _mkdir(d)
 #endif
 
+#ifdef TC_SAMBA4X_NETBSD4_COMPAT
+#include "tc_netbsd4_compat.c"
+#endif
+
 void replace_dummy(void);
 void replace_dummy(void) {}
 
@@ -1389,7 +1393,21 @@ int rep_renameat2(int __oldfd, const char *__old, int __newfd,
 		return -1;
 	}
 
+#if defined(HAVE_RENAMEAT) || !defined(TC_SAMBA4X_NETBSD4_COMPAT)
 	return renameat(__oldfd, __old, __newfd, __new);
+#else
+	/*
+	 * NetBSD4 has neither renameat2() nor renameat(). Absolute paths and
+	 * AT_FDCWD can still use rename(); real SMB relative-dirfd renames are
+	 * handled in source3/modules/vfs_default.c with Samba path context.
+	 */
+	if (rep_at_path_is_direct(__oldfd, __old) &&
+	    rep_at_path_is_direct(__newfd, __new)) {
+		return rename(__old, __new);
+	}
+	errno = ENOSYS;
+	return -1;
+#endif
 }
 #endif /* ! HAVE_RENAMEAT2 */
 
diff --git a/lib/replace/system/filesys.h b/lib/replace/system/filesys.h
--- a/lib/replace/system/filesys.h
+++ b/lib/replace/system/filesys.h
@@ -189,6 +189,43 @@
 #define O_ACCMODE (O_RDONLY | O_WRONLY | O_RDWR)
 #endif
 
+/*
+ * TimeCapsuleSMB NetBSD compatibility notes:
+ *
+ * NetBSD 6/7 provide the modern *at family that Samba 4.24's source3 VFS
+ * expects, so those builds use the native libc/kernel paths.
+ *
+ * NetBSD 4 lacks that API surface. These definitions are not meant to pretend
+ * that the kernel implements Linux-style *at semantics; they only let the
+ * NetBSD4 compatibility code compile. The real file-server fallbacks live in
+ * source3/modules/vfs_default.c, where Samba still has dirfsp path context.
+ */
+#ifndef O_DIRECTORY
+#define O_DIRECTORY 0
+#endif
+#ifndef AT_FDCWD
+#define AT_FDCWD -100
+#endif
+#ifndef AT_REMOVEDIR
+#define AT_REMOVEDIR 0x01
+#endif
+#ifndef AT_SYMLINK_NOFOLLOW
+#define AT_SYMLINK_NOFOLLOW 0x02
+#endif
+
+#ifdef TC_SAMBA4X_NETBSD4_COMPAT
+int openat(int dirfd, const char *path, int flags, ...);
+int mkdirat(int dirfd, const char *path, mode_t mode);
+int unlinkat(int dirfd, const char *path, int flags);
+int symlinkat(const char *target, int newdirfd, const char *linkpath);
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t bufsiz);
+int linkat(int olddirfd, const char *oldpath, int newdirfd, const char *newpath, int flags);
+int fstatat(int dirfd, const char *path, struct stat *buf, int flags);
+int futimens(int fd, const struct timespec times[2]);
+int utimensat(int dirfd, const char *path, const struct timespec times[2], int flags);
+void arc4random_buf(void *buf, size_t n);
+#endif
+
 #ifndef MAXPATHLEN
 #define MAXPATHLEN 256
 #endif
