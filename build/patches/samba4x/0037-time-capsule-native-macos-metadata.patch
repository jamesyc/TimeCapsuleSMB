+
+static bool tc_xattr_list_contains(const char *list,
+				   size_t list_size,
+				   const char *name)
+{
+	size_t name_size = strlen(name) + 1;
+	size_t offset = 0;
+
+	while (offset < list_size) {
+		size_t entry_size = strnlen(list + offset, list_size - offset) + 1;
+
+		if (entry_size > list_size - offset) {
+			return false;
+		}
+		if (entry_size == name_size &&
+		    memcmp(list + offset, name, name_size) == 0)
+		{
+			return true;
+		}
+		offset += entry_size;
+	}
+	return false;
+}
+
+static bool tc_xattr_tdb_backend_missing(int error)
+{
+	return error == ENOATTR || error == ENOENT;
+}
+
+static bool tc_xattr_tdb_native_unavailable(int error)
+{
+	return tc_xattr_tdb_backend_missing(error) ||
+		error == ENOTSUP || error == EOPNOTSUPP || error == ENOSYS;
+}
+
+static ssize_t tc_native_usertags_get(struct files_struct *fsp,
+				      void *value,
+				      size_t size)
+{
+	ssize_t raw_size;
+	ssize_t ret;
+	int fd = fsp_get_pathref_fd(fsp);
+
+	if (fd == -1) {
+		errno = EBADF;
+		return -1;
+	}
+
+	raw_size = tc_airport_fgetxattr(
+		fd, TC_USERTAGS_NATIVE_XATTR, NULL, 0);
+	if (raw_size < 0) {
+		if (tc_xattr_tdb_native_unavailable(errno)) {
+			errno = ENOATTR;
+		}
+		return -1;
+	}
+	if (raw_size >= SSIZE_MAX) {
+		errno = EOVERFLOW;
+		return -1;
+	}
+	if (size == 0) {
+		return raw_size + 1;
+	}
+	if ((size_t)raw_size + 1 > size) {
+		errno = ERANGE;
+		return -1;
+	}
+
+	ret = tc_airport_fgetxattr(
+		fd, TC_USERTAGS_NATIVE_XATTR, value, raw_size);
+	if (ret < 0) {
+		return -1;
+	}
+	if (ret > raw_size) {
+		errno = EIO;
+		return -1;
+	}
+
+	/* streams_xattr reserves the final byte as its extent marker. */
+	((uint8_t *)value)[ret] = 0;
+	return ret + 1;
+}
+
+static int tc_native_usertags_exists(struct files_struct *fsp)
+{
+	ssize_t ret = tc_airport_fgetxattr(
+		fsp_get_pathref_fd(fsp), TC_USERTAGS_NATIVE_XATTR, NULL, 0);
+
+	if (ret >= 0) {
+		return 1;
+	}
+	if (tc_xattr_tdb_native_unavailable(errno)) {
+		return 0;
+	}
+	return -1;
+}
+
+static void tc_native_usertags_mirror(struct files_struct *fsp,
+				       const void *value,
+				       size_t size)
+{
+	const uint8_t *bytes = value;
+	int ret;
+
+	if (size <= 1 || bytes[size - 1] != 0) {
+		/* ponytail: Finder tag plists fit one xattr. Do not leave an older
+		 * native tag visible for an empty stream or if a future oversized tag
+		 * needs multiple extents. */
+		ret = tc_airport_fremovexattr(
+			fsp_get_pathref_fd(fsp), TC_USERTAGS_NATIVE_XATTR);
+		if (ret != 0 && !tc_xattr_tdb_native_unavailable(errno)) {
+			DBG_WARNING(
+				"Native Finder-tag cleanup failed for [%s]: %s\n",
+				fsp_str_dbg(fsp), strerror(errno));
+		}
+		return;
+	}
+
+	ret = tc_airport_fsetxattr(fsp_get_pathref_fd(fsp),
+				     TC_USERTAGS_NATIVE_XATTR,
+				     value,
+				     size - 1);
+	if (ret != 0 && !tc_xattr_tdb_native_unavailable(errno)) {
+		DBG_WARNING("Native Finder-tag mirror failed for [%s]: %s\n",
+			    fsp_str_dbg(fsp), strerror(errno));
+	}
+}
