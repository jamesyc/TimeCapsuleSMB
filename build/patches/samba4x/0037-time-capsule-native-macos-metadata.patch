+#define TC_FINDERINFO_NATIVE_XATTR "com.apple.FinderInfo"
+
+static bool tc_fruit_backend_missing(int error)
+{
+	return error == ENOATTR || error == ENOENT;
+}
+
+static bool tc_fruit_native_unavailable(int error)
+{
+	return tc_fruit_backend_missing(error) ||
+		error == ENOTSUP || error == EOPNOTSUPP || error == ENOSYS;
+}
+
+/* Return 1 for a 32-byte native FinderInfo value, 0 when absent, -1 on
+ * a real error. The AirPort kernel exposes this through private syscalls
+ * even though its stock NetBSD libc does not provide matching wrappers. */
+static int tc_native_finderinfo_read_fsp(files_struct *fsp,
+					 uint8_t finderinfo[AFP_FinderSize])
+{
+	ssize_t size;
+	ssize_t ret;
+	int fd = fsp_get_pathref_fd(fsp);
+
+	/* Named AFP streams on symlinks are not a native-HFS fallback case. In
+	 * particular, never read or mutate FinderInfo on the symlink target. */
+	if (S_ISLNK(fsp->fsp_name->st.st_ex_mode)) {
+		errno = ENOENT;
+		return 0;
+	}
+	if (fd == -1) {
+		errno = EBADF;
+		return -1;
+	}
+
+	size = tc_airport_fgetxattr(
+		fd, TC_FINDERINFO_NATIVE_XATTR, NULL, 0);
+	if (size < 0) {
+		return tc_fruit_native_unavailable(errno) ? 0 : -1;
+	}
+	if (size != AFP_FinderSize) {
+		errno = EIO;
+		return -1;
+	}
+
+	ret = tc_airport_fgetxattr(
+		fd, TC_FINDERINFO_NATIVE_XATTR, finderinfo, AFP_FinderSize);
+	if (ret != AFP_FinderSize) {
+		if (ret < 0 && tc_fruit_native_unavailable(errno)) {
+			return 0;
+		}
+		if (ret >= 0) {
+			errno = EIO;
+		}
+		return -1;
+	}
+	return 1;
+}
+
+static int tc_native_finderinfo_read_at(
+	vfs_handle_struct *handle,
+	const struct files_struct *dirfsp,
+	const struct smb_filename *smb_fname,
+	uint8_t finderinfo[AFP_FinderSize])
+{
+	struct fruit_config_data *config = NULL;
+	struct smb_filename *base_name = NULL;
+	files_struct *base_fsp = NULL;
+	NTSTATUS status;
+	int ret;
+
+	if (smb_fname->fsp != NULL) {
+		base_fsp = smb_fname->fsp;
+		if (fsp_is_alternate_stream(base_fsp)) {
+			base_fsp = base_fsp->base_fsp;
+		}
+		return tc_native_finderinfo_read_fsp(base_fsp, finderinfo);
+	}
+
+	SMB_VFS_HANDLE_GET_DATA(handle, config,
+				struct fruit_config_data, return -1);
+	if (config->in_openat_pathref_fsp) {
+		errno = ENOENT;
+		return 0;
+	}
+
+	base_name = cp_smb_filename_nostream(talloc_tos(), smb_fname);
+	if (base_name == NULL) {
+		errno = ENOMEM;
+		return -1;
+	}
+
+	config->in_openat_pathref_fsp = true;
+	status = openat_pathref_fsp_lcomp(
+		discard_const_p(struct files_struct, dirfsp), base_name, 0);
+	config->in_openat_pathref_fsp = false;
+	if (!NT_STATUS_IS_OK(status)) {
+		int error = map_errno_from_nt_status(status);
+
+		TALLOC_FREE(base_name);
+		errno = error;
+		return tc_fruit_backend_missing(error) ? 0 : -1;
+	}
+
+	ret = tc_native_finderinfo_read_fsp(base_name->fsp, finderinfo);
+	{
+		int error = errno;
+
+		TALLOC_FREE(base_name);
+		errno = error;
+	}
+	return ret;
+}
+
+static void tc_native_finderinfo_mirror(files_struct *base_fsp,
+					const uint8_t finderinfo[AFP_FinderSize])
+{
+	int ret;
+
+	if (S_ISLNK(base_fsp->fsp_name->st.st_ex_mode)) {
+		return;
+	}
+	if (all_zero(finderinfo, AFP_FinderSize)) {
+		ret = tc_airport_fremovexattr(
+			fsp_get_pathref_fd(base_fsp), TC_FINDERINFO_NATIVE_XATTR);
+		if (ret == 0 || tc_fruit_native_unavailable(errno)) {
+			return;
+		}
+	} else {
+		ret = tc_airport_fsetxattr(
+			fsp_get_pathref_fd(base_fsp),
+			TC_FINDERINFO_NATIVE_XATTR,
+			finderinfo,
+			AFP_FinderSize);
+		if (ret == 0 || tc_fruit_native_unavailable(errno)) {
+			return;
+		}
+	}
+
+	DBG_WARNING("Native FinderInfo mirror failed for [%s]: %s\n",
+		    fsp_str_dbg(base_fsp), strerror(errno));
+}
+
+/* Return 1 when removed, 0 when absent, -1 on a real error. */
+static int tc_native_finderinfo_remove_at(
+	vfs_handle_struct *handle,
+	const struct files_struct *dirfsp,
+	const struct smb_filename *smb_fname)
+{
+	struct fruit_config_data *config = NULL;
+	struct smb_filename *base_name = NULL;
+	files_struct *base_fsp = NULL;
+	NTSTATUS status;
+	int ret;
+
+	if (smb_fname->fsp != NULL) {
+		base_fsp = smb_fname->fsp;
+		if (fsp_is_alternate_stream(base_fsp)) {
+			base_fsp = base_fsp->base_fsp;
+		}
+	} else {
+		SMB_VFS_HANDLE_GET_DATA(handle, config,
+					struct fruit_config_data, return -1);
+		base_name = cp_smb_filename_nostream(talloc_tos(), smb_fname);
+		if (base_name == NULL) {
+			errno = ENOMEM;
+			return -1;
+		}
+		config->in_openat_pathref_fsp = true;
+		status = openat_pathref_fsp_lcomp(
+			discard_const_p(struct files_struct, dirfsp), base_name, 0);
+		config->in_openat_pathref_fsp = false;
+		if (!NT_STATUS_IS_OK(status)) {
+			int error = map_errno_from_nt_status(status);
+
+			TALLOC_FREE(base_name);
+			errno = error;
+			return tc_fruit_backend_missing(error) ? 0 : -1;
+		}
+		base_fsp = base_name->fsp;
+	}
+	if (S_ISLNK(base_fsp->fsp_name->st.st_ex_mode)) {
+		TALLOC_FREE(base_name);
+		errno = ENOENT;
+		return 0;
+	}
+
+	ret = tc_airport_fremovexattr(
+		fsp_get_pathref_fd(base_fsp), TC_FINDERINFO_NATIVE_XATTR);
+	{
+		int error = errno;
+
+		TALLOC_FREE(base_name);
+		errno = error;
+	}
+	if (ret == 0) {
+		return 1;
+	}
+	return tc_fruit_native_unavailable(errno) ? 0 : -1;
+}
