+		DBG_ERR("tc_desync: WRITE mid %" PRIu64 " holds the next "
+			"request's header: not writing it, reading and "
+			"answering nothing more on this connection\n",
+			BVAL(state->pktbuf, SMB2_HDR_MESSAGE_ID));
+		tc_out_of_step = true;
+	}
+
+	if (state->hdr.nbt[0] != 0x00 || tc_out_of_step) {
 		DEBUG(1,("ignore NBT[0x%02X] msg\n",
 			 state->hdr.nbt[0]));
 
