+		 * the request is freed, which is when the connection ends.
+		 */
+		TALLOC_FREE(state->pktbuf);
 		*state = (struct smbd_smb2_request_read_state) {
 			.req = req,
 			.min_recv_size = lp_min_receive_file_size(),
