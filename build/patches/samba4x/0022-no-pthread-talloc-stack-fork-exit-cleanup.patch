+	talloc_stackframe_cleanup_for_exit();
 	exit(0);
 }
@@ -257,6 +258,14 @@ NTSTATUS smbd_reinit_after_fork(struct messaging_context *msg_ctx,
 	NTSTATUS ret;
 	am_parent = NULL;
