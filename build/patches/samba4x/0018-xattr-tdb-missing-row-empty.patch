diff --git a/source3/lib/xattr_tdb.c b/source3/lib/xattr_tdb.c
--- a/source3/lib/xattr_tdb.c
+++ b/source3/lib/xattr_tdb.c
@@ -116,7 +116,21 @@ static NTSTATUS xattr_tdb_load_attrs(TALLOC_CTX *mem_ctx,
 			      &data);
 	if (!NT_STATUS_IS_OK(status)) {
 		if (NT_STATUS_EQUAL(status, NT_STATUS_NOT_FOUND)) {
-			return status;
+			/*
+			 * Untouched files and directories legitimately have no
+			 * xattr.tdb row yet. Treat a missing row as an empty
+			 * xattr set, so every caller of this library sees the
+			 * attribute as missing (ENOATTR) instead of EINVAL.
+			 * vfs_xattr_tdb's fgetxattr already mapped its errors to
+			 * ENOATTR; EINVAL escaped through getxattrat (async
+			 * dosmode) and to direct callers such as the metadata
+			 * migrator.
+			 */
+			*presult = talloc_zero(mem_ctx, struct tdb_xattrs);
+			if (*presult == NULL) {
+				return NT_STATUS_NO_MEMORY;
+			}
+			return NT_STATUS_OK;
 		}
 		return NT_STATUS_INTERNAL_DB_CORRUPTION;
 	}
