diff --git a/source3/lib/xattr_tdb.c b/source3/lib/xattr_tdb.c
--- a/source3/lib/xattr_tdb.c
+++ b/source3/lib/xattr_tdb.c
@@ -188,6 +188,15 @@ ssize_t xattr_tdb_getattr(struct db_context *db_ctx,
 
 	status = xattr_tdb_load_attrs(frame, db_ctx, id, &attribs);
 
+	if (NT_STATUS_EQUAL(status, NT_STATUS_NOT_FOUND)) {
+		/*
+		 * A file without a row has no xattrs yet: the attribute is
+		 * missing, as for a row without it.
+		 */
+		TALLOC_FREE(frame);
+		errno = ENOATTR;
+		return -1;
+	}
 	if (!NT_STATUS_IS_OK(status)) {
 		DEBUG(10, ("xattr_tdb_fetch_attrs failed: %s\n",
 			   nt_errstr(status)));
