diff --git a/source3/lib/xattr_tdb.c b/source3/lib/xattr_tdb.c
--- a/source3/lib/xattr_tdb.c
+++ b/source3/lib/xattr_tdb.c
@@ -377,8 +377,15 @@ ssize_t xattr_tdb_listattr(struct db_context *db_ctx,
 
 	if (len > size) {
 		TALLOC_FREE(frame);
+		/*
+		 * A probe with size 0 gets the length it needs. A nonzero
+		 * buffer that is too small fails with ERANGE, as
+		 * listxattr(2) does: callers such as get_ea_names_from_fsp()
+		 * retry with a larger buffer only then, and take a positive
+		 * return for the bytes written into theirs.
+		 */
 		errno = ERANGE;
-		return len;
+		return size == 0 ? len : -1;
 	}
 
 	len = 0;
