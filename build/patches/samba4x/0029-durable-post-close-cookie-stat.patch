diff --git a/source3/smbd/durable.c b/source3/smbd/durable.c
--- a/source3/smbd/durable.c
+++ b/source3/smbd/durable.c
@@ -189,6 +189,7 @@ NTSTATUS vfs_default_durable_disconnect(struct files_struct *fsp,
 	struct vfs_default_durable_cookie cookie;
 	DATA_BLOB new_cookie_blob = data_blob_null;
 	struct durable_disconnect_state state;
+	struct file_id post_close_file_id;
 
 	*new_cookie = data_blob_null;
 
@@ -278,6 +279,37 @@ NTSTATUS vfs_default_durable_disconnect(struct files_struct *fsp,
 		return status;
 	}
 
+	/*
+	 * HFS on the device can advance ctime as the last writable fd
+	 * closes. Store the durable cookie after fd_close(), so that the
+	 * reconnect check compares against the metadata as it stands after
+	 * the close, not a snapshot that is stale before the client can
+	 * reconnect.
+	 */
+	status = fd_close(fsp);
+	if (!NT_STATUS_IS_OK(status)) {
+		return status;
+	}
+
+	/*
+	 * With the fd closed this stats fsp_name by name, from the working
+	 * directory; a shutdown close starts from this file's share root
+	 * (0062), as every request does.
+	 */
+	status = vfs_stat_fsp(fsp);
+	if (!NT_STATUS_IS_OK(status)) {
+		return status;
+	}
+
+	post_close_file_id = vfs_file_id_from_sbuf(conn, &fsp->fsp_name->st);
+	if (!file_id_equal(&fsp->file_id, &post_close_file_id)) {
+		DBG_WARNING("TIMECAPSULE_DURABLE_POST_CLOSE_STAT: "
+			    "%s changed file id across durable fd_close; "
+			    "refusing durable reconnect cookie\n",
+			    fsp_str_dbg(fsp));
+		return NT_STATUS_OBJECT_NAME_NOT_FOUND;
+	}
+
 	ZERO_STRUCT(cookie);
 	cookie.allow_reconnect = true;
 	cookie.id = fsp->file_id;
@@ -317,10 +349,14 @@ NTSTATUS vfs_default_durable_disconnect(struct files_struct *fsp,
 	}
 
 do_close:
-	status = fd_close(fsp);
-	if (!NT_STATUS_IS_OK(status)) {
-		data_blob_free(&new_cookie_blob);
-		return status;
+	/* The persistent-handle path skips the post-close cookie refresh above.
+	 * Close only that path here; ordinary durable handles are already closed. */
+	if (fsp->op->global->persistent) {
+		status = fd_close(fsp);
+		if (!NT_STATUS_IS_OK(status)) {
+			data_blob_free(&new_cookie_blob);
+			return status;
+		}
 	}
 
 	*new_cookie = new_cookie_blob;
