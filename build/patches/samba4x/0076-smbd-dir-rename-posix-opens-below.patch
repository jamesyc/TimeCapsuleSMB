+/*
+ * POSIX directory renames leave the client's open descendants usable through
+ * their descriptors. Keep their names usable too: durable disconnect closes
+ * the descriptor and stats that name before saving its reconnect cookie.
+ * Reuse ordinary file rename bookkeeping for share modes, leases and other
+ * processes with the same file open. This walks this client's opens, just as
+ * file_find_subpath() does with strict rename disabled. Directory broadcasts
+ * run the same repair in other clients; no filesystem scan is needed. The caller must release the directory's share lock first: Samba can
+ * hold only one share-mode lock at a time.
+ */
+NTSTATUS rename_open_files_below(connection_struct *conn,
+                                      const struct smb_filename *src,
+                                      const struct smb_filename *dst)
+{
+	files_struct *fsp;
+	const char *old = src->base_name;
+	const char *new = dst->base_name;
+	size_t components = 1;
+	const char *p;
+
+	if (strncmp(old, "./", 2) == 0) old += 2;
+	if (strncmp(new, "./", 2) == 0) new += 2;
+	for (p = old; *p != '\0'; p++) {
+		if (*p == '/') components++;
+	}
+
+	for (fsp = conn->sconn->files; fsp != NULL; fsp = fsp->next) {
+		const char *name = fsp->fsp_name->base_name;
+		const char *suffix;
+		char *parent;
+		size_t i;
+		struct smb_filename *renamed = NULL;
+		struct share_mode_lock *lck = NULL;
+		bool ok;
+
+		if (strcmp(fsp->conn->connectpath, conn->connectpath) != 0) {
+			continue;
+		}
+		if (strncmp(name, "./", 2) == 0) name += 2;
+		/* Compare whole parent strings: strnequal() counts characters,
+		 * not UTF-8 bytes, and case-equivalent spellings can have different
+		 * byte lengths. Component boundaries also locate the right suffix. */
+		suffix = name;
+		for (i = 0; i < components; i++) {
+			suffix = strchr(suffix, '/');
+			if (suffix == NULL) break;
+			if (i + 1 < components) suffix++;
+		}
+		if (suffix == NULL) continue;
+		parent = talloc_strndup(talloc_tos(), name, suffix - name);
+		if (parent == NULL) return NT_STATUS_NO_MEMORY;
+		ok = conn->case_sensitive ? strcmp(parent, old) == 0 : strequal(parent, old);
+		TALLOC_FREE(parent);
+		if (!ok) continue;
+		renamed = cp_smb_filename(talloc_tos(), fsp->fsp_name);
+		if (renamed == NULL) return NT_STATUS_NO_MEMORY;
+		TALLOC_FREE(renamed->base_name);
+		renamed->base_name = talloc_asprintf(renamed, "%s%s", new, suffix);
+		if (renamed->base_name == NULL) {
+			TALLOC_FREE(renamed);
+			return NT_STATUS_NO_MEMORY;
+		}
+		/* A previous handle or notification may have already updated this
+		 * name, especially when only the parent's case changed. */
+		if (strcmp(fsp->fsp_name->base_name, renamed->base_name) == 0) {
+			TALLOC_FREE(renamed);
+			continue;
+		}
+		/* A directory notification can arrive after its old name was
+		 * reused. Do not retarget a newly opened replacement: the new
+		 * path must still identify this open file (or a stream's base).
+		 * Use the share-root descriptor, not the callback's current cwd. */
+		{
+			files_struct *base = fsp->base_fsp != NULL ? fsp->base_fsp : fsp;
+			SMB_STRUCT_STAT st;
+			struct file_id id;
+			char *stream = renamed->stream_name;
+			int flags = S_ISLNK(base->fsp_name->st.st_ex_mode)
+				? AT_SYMLINK_NOFOLLOW : 0;
+			int ret;
+
+			renamed->stream_name = NULL;
+			ret = SMB_VFS_FSTATAT(fsp->conn, fsp->conn->cwd_fsp,
+					      renamed, &st, flags);
+			renamed->stream_name = stream;
+			if (ret != 0) {
+				DBG_WARNING("Cannot verify renamed descendant %s: %s\n",
+					    smb_fname_str_dbg(renamed), strerror(errno));
+				TALLOC_FREE(renamed);
+				continue;
+			}
+			id = vfs_file_id_from_sbuf(fsp->conn, &st);
+			if (!file_id_equal(&id, &base->file_id)) {
+				TALLOC_FREE(renamed);
+				continue;
+			}
+		}
+		lck = get_existing_share_mode_lock(talloc_tos(), fsp->file_id);
+		if (lck != NULL) {
+			rename_open_files(conn, lck, fsp->file_id,
+					  fsp->name_hash, renamed);
+			TALLOC_FREE(lck);
+			ok = strcmp(fsp->fsp_name->base_name, renamed->base_name) == 0;
+		} else {
+			/* Internal path references have no share-mode record. */
+			ok = fsp_set_smb_fname(fsp, renamed);
+		}
+		TALLOC_FREE(renamed);
+		if (!ok) return NT_STATUS_NO_MEMORY;
+	}
+	return NT_STATUS_OK;
+}
