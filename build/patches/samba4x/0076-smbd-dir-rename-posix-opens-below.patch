+/*
+ * A directory rename leaves the opens below it usable through their
+ * descriptors, but their names still lead to the old path, and a durable
+ * disconnect closes the descriptor and stats the name before it saves the
+ * reconnect cookie. Give this smbd's opens below src the same path below
+ * dst, with the bookkeeping a file rename does: share modes, leases, and
+ * other smbds with the same file open. This walks this smbd's opens, as
+ * file_find_subpath() does when "strict rename" is off; other smbds do the
+ * same when the rename message reaches them (msg_file_was_renamed()). The
+ * names are relative to the share root, which must be the working
+ * directory. The caller must not hold a share mode lock: smbd holds only
+ * one at a time.
+ */
+NTSTATUS rename_open_files_below(connection_struct *conn,
+				 const struct smb_filename *src,
+				 const struct smb_filename *dst)
+{
+	const char *src_name = src->base_name;
+	const char *dst_name = dst->base_name;
+	size_t components = 1;
+	files_struct *fsp = NULL;
+	const char *p = NULL;
+
+	if (strncmp(src_name, "./", 2) == 0) {
+		src_name += 2;
+	}
+	if (strncmp(dst_name, "./", 2) == 0) {
+		dst_name += 2;
+	}
+	for (p = src_name; *p != '\0'; p++) {
+		if (*p == '/') {
+			components++;
+		}
+	}
+
+	for (fsp = conn->sconn->files; fsp != NULL; fsp = fsp->next) {
+		const char *name = fsp->fsp_name->base_name;
+		struct smb_filename *renamed = NULL;
+		struct share_mode_lock *lck = NULL;
+		files_struct *base = NULL;
+		const char *suffix = NULL;
+		char *parent = NULL;
+		char *stream = NULL;
+		SMB_STRUCT_STAT st;
+		struct file_id id;
+		size_t i;
+		int flags;
+		int ret;
+		bool ok;
+
+		if (strcmp(fsp->conn->connectpath, conn->connectpath) != 0) {
+			continue;
+		}
+		if (strncmp(name, "./", 2) == 0) {
+			name += 2;
+		}
+
+		/*
+		 * Compare the name's first "components" components with src
+		 * as a whole string: strnequal() counts characters, not
+		 * UTF-8 bytes, and case-equivalent spellings can differ in
+		 * byte length. The rest of the name is the suffix to keep.
+		 */
+		suffix = name;
+		for (i = 0; i < components; i++) {
+			suffix = strchr(suffix, '/');
+			if (suffix == NULL) {
+				break;
+			}
+			if (i + 1 < components) {
+				suffix++;
+			}
+		}
+		if (suffix == NULL) {
+			continue;
+		}
+		parent = talloc_strndup(talloc_tos(), name, suffix - name);
+		if (parent == NULL) {
+			return NT_STATUS_NO_MEMORY;
+		}
+		if (conn->case_sensitive) {
+			ok = (strcmp(parent, src_name) == 0);
+		} else {
+			ok = strequal(parent, src_name);
+		}
+		TALLOC_FREE(parent);
+		if (!ok) {
+			continue;
+		}
+
+		renamed = cp_smb_filename(talloc_tos(), fsp->fsp_name);
+		if (renamed == NULL) {
+			return NT_STATUS_NO_MEMORY;
+		}
+		TALLOC_FREE(renamed->base_name);
+		renamed->base_name = talloc_asprintf(renamed,
+						     "%s%s",
+						     dst_name,
+						     suffix);
+		if (renamed->base_name == NULL) {
+			TALLOC_FREE(renamed);
+			return NT_STATUS_NO_MEMORY;
+		}
+
+		/*
+		 * Another handle of the same file, or an earlier message,
+		 * may have renamed this open already, as a case-only rename
+		 * does.
+		 */
+		if (strcmp(fsp->fsp_name->base_name, renamed->base_name) == 0) {
+			TALLOC_FREE(renamed);
+			continue;
+		}
+
+		/*
+		 * A message can arrive after the new name was taken again.
+		 * Rename only an open the new name still leads to (for a
+		 * stream, its base file).
+		 */
+		base = (fsp->base_fsp != NULL) ? fsp->base_fsp : fsp;
+		flags = S_ISLNK(base->fsp_name->st.st_ex_mode) ?
+			AT_SYMLINK_NOFOLLOW : 0;
+		stream = renamed->stream_name;
+		renamed->stream_name = NULL;
+		ret = SMB_VFS_FSTATAT(fsp->conn,
+				      fsp->conn->cwd_fsp,
+				      renamed,
+				      &st,
+				      flags);
+		renamed->stream_name = stream;
+		if (ret != 0) {
+			DBG_WARNING("Cannot stat renamed %s: %s\n",
+				    smb_fname_str_dbg(renamed),
+				    strerror(errno));
+			TALLOC_FREE(renamed);
+			continue;
+		}
+		id = vfs_file_id_from_sbuf(fsp->conn, &st);
+		if (!file_id_equal(&id, &base->file_id)) {
+			TALLOC_FREE(renamed);
+			continue;
+		}
+
+		lck = get_existing_share_mode_lock(talloc_tos(), fsp->file_id);
+		if (lck != NULL) {
+			rename_open_files(conn,
+					  lck,
+					  fsp->file_id,
+					  fsp->name_hash,
+					  renamed);
+			TALLOC_FREE(lck);
+			ok = (strcmp(fsp->fsp_name->base_name,
+				     renamed->base_name) == 0);
+		} else {
+			/* An internal path reference has no share mode entry. */
+			ok = fsp_set_smb_fname(fsp, renamed);
+		}
+		TALLOC_FREE(renamed);
+		if (!ok) {
+			return NT_STATUS_NO_MEMORY;
+		}
+	}
+	return NT_STATUS_OK;
+}
+
+/*
+ * After a directory rename on disk, rename the opens below it in this smbd
+ * and, with a MSG_SMB_FILE_RENAME that carries old_base_name, in every
+ * other smbd: their clients may hold opens below the directory without
+ * holding the directory itself. The rename is done, so a failure here
+ * only logs.
+ */
+static void rename_opens_below(connection_struct *conn,
+			       files_struct *fsp,
+			       const struct smb_filename *old_fname,
+			       struct files_struct *dst_dirfsp,
+			       const struct smb_filename *smb_fname_dst_rel)
+{
+	TALLOC_CTX *frame = talloc_stackframe();
+	struct file_rename_message msg = {
+		.id = fsp->file_id,
+		.servicepath = conn->connectpath,
+		.old_base_name = old_fname->base_name,
+	};
+	struct smb_filename *dst = NULL;
+	DATA_BLOB blob = data_blob_null;
+	enum ndr_err_code ndr_err;
+	NTSTATUS status;
+
+	/*
+	 * The destination lookup returns an existing name in its stored
+	 * case; the opens take the spelling the rename used.
+	 */
+	dst = full_path_from_dirfsp_atname(frame,
+					   dst_dirfsp,
+					   smb_fname_dst_rel);
+	if (dst == NULL) {
+		DBG_WARNING("full_path_from_dirfsp_atname failed\n");
+		goto done;
+	}
+	msg.base_name = dst->base_name;
+
+	status = rename_open_files_below(conn, old_fname, dst);
+	if (!NT_STATUS_IS_OK(status)) {
+		DBG_WARNING("Renaming the opens below %s failed: %s\n",
+			    old_fname->base_name,
+			    nt_errstr(status));
+	}
+
+	ndr_err = ndr_push_struct_blob(
+		&blob,
+		frame,
+		&msg,
+		(ndr_push_flags_fn_t)ndr_push_file_rename_message);
+	if (!NDR_ERR_CODE_IS_SUCCESS(ndr_err)) {
+		DBG_WARNING("ndr_push_file_rename_message failed: %s\n",
+			    ndr_errstr(ndr_err));
+		goto done;
+	}
+	messaging_send_all(conn->sconn->msg_ctx,
+			   MSG_SMB_FILE_RENAME,
+			   blob.data,
+			   blob.length);
+done:
+	TALLOC_FREE(frame);
+}
