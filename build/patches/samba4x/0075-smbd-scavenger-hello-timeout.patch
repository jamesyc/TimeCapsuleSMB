-static bool scavenger_wait_hello(int fd, struct server_id *child)
+#ifndef SCAVENGER_HELLO_TIMEOUT_SECONDS
+/*
+ * How long the parent waits for a new scavenger's hello. The parent serves
+ * nothing while it waits: no new connections, no reaping. A child that never
+ * says hello would stop it for good, so give up and kill the child. The
+ * expiry that started it is lost: that handle stays disconnected until
+ * another open of its file finds it stale. Later expiries start another
+ * scavenger. The child opens its log file before its hello, so this allows
+ * for a disk spinning up.
+ */
+#define SCAVENGER_HELLO_TIMEOUT_SECONDS 30
+#endif
+
+static bool scavenger_wait_hello(int fd, pid_t pid, struct server_id *child)
 {
 	struct server_id_buf tmp;
+	struct pollfd pfd = { .fd = fd, .events = POLLIN };
 	ssize_t ret;
+	int ready;
+
+	ready = sys_poll_intr(&pfd, 1, SCAVENGER_HELLO_TIMEOUT_SECONDS * 1000);
+	if (ready != 1) {
+		DBG_ERR("scavenger %d sent no hello within %d seconds (%s)\n",
+			(int)pid, SCAVENGER_HELLO_TIMEOUT_SECONDS,
+			ready == 0 ? "timeout" : strerror(errno));
+		goto fail;
+	}
 
 	ret = read_data(fd, child, sizeof(struct server_id));
 	if (ret == -1) {
 		DEBUG(2, ("Failed to read from pipe: %s\n",
 			  strerror(errno)));
-		return false;
+		goto fail;
 	}
 	if (ret < sizeof(struct server_id)) {
 		DBG_WARNING("Could not read serverid\n");
-		return false;
+		goto fail;
 	}
 
 	DEBUG(4, ("scavenger_say_hello: child[%s]\n",
 		  server_id_str_buf(*child, &tmp)));
 	return true;
+
+fail:
+	/*
+	 * Nothing will talk to a child without a hello, and one that is
+	 * still running would serve no one.
+	 */
+	kill(pid, SIGKILL);
+	return false;
 }
 
