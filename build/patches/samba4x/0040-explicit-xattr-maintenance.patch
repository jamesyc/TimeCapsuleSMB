+/* Migration is offline. Stop only known file-service owners and writers;
+ * ACP and diskd remain available for router and storage management. */
+static int tc_stop_legacy_writers(void)
+{
+	static const char *const names[] = {
+		"smbd", "rsync", "discoveryd", "telemetry", "wcifsnd",
+		"wcifsfs", "afpserver"
+	};
+	static const char *const scripts[] = {
+		"^/bin/sh /mnt/Flash/manager.sh([[:space:]]|$)",
+		"^/bin/sh /mnt/Flash/watchdog.sh([[:space:]]|$)",
+		"^/bin/sh /mnt/Flash/boot.sh([[:space:]]|$)"
+	};
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(scripts); i++) {
+		if (tc_pkill("-TERM", "-f", scripts[i]) != 0) {
+			return -1;
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		if (tc_pkill("-TERM", "-x", names[i]) != 0) {
+			return -1;
+		}
+	}
+	sleep(2);
+	for (i = 0; i < ARRAY_SIZE(scripts); i++) {
+		if (tc_pkill("-KILL", "-f", scripts[i]) != 0) {
+			return -1;
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		if (tc_pkill("-KILL", "-x", names[i]) != 0) {
+			return -1;
+		}
+	}
+	return 0;
+}
