+static int tc_write_status(const char *state, const char *phase,
+			   uint64_t entries, uint64_t conversions,
+			   uint64_t warnings, uint64_t errors,
+			   const char *detail)
+{
+	char temporary[PATH_MAX];
+	FILE *file;
+
+	if (tc_live_status_path == NULL ||
+	    snprintf(temporary, sizeof(temporary), "%s.%ld",
+		     tc_live_status_path, (long)getpid()) >= (int)sizeof(temporary))
+	{
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	file = fopen(temporary, "w");
+	if (file == NULL) {
+		return -1;
+	}
+	fprintf(file,
+		"state=%s\noperation_id=%s\nphase=%s\n"
+		"entries=%"PRIu64"\nconversions=%"PRIu64"\n"
+		"warnings=%"PRIu64"\nerrors=%"PRIu64"\ndetail=%s\n",
+		state, tc_operation_id == NULL ? "" : tc_operation_id,
+		phase == NULL ? "" : phase, entries, conversions,
+		warnings, errors, detail == NULL ? "" : detail);
+	if (fflush(file) != 0 || fsync(fileno(file)) != 0 || fclose(file) != 0 ||
+	    rename(temporary, tc_live_status_path) != 0)
+	{
+		int error = errno;
+		unlink(temporary);
+		errno = error;
+		return -1;
+	}
+	return 0;
+}
