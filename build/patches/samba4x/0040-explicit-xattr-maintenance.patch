+static int tc_parse_maintenance(TALLOC_CTX *mem_ctx, int argc, char **argv,
+				struct tc_maintenance *operation)
+{
+	int i;
+
+	ZERO_STRUCTP(operation);
+	for (i = 2; i < argc; i++) {
+		const char *name = argv[i];
+		const char *value;
+
+		if (strcmp(name, "--volume") == 0) {
+			const char **ids;
+			const char **roots;
+			if (i + 2 >= argc) {
+				return -1;
+			}
+			ids = talloc_realloc(mem_ctx, operation->volume_ids,
+					     const char *, operation->num_volumes + 1);
+			roots = talloc_realloc(mem_ctx, operation->roots,
+					       const char *, operation->num_volumes + 1);
+			if (ids == NULL || roots == NULL) {
+				return -1;
+			}
+			operation->volume_ids = ids;
+			operation->roots = roots;
+			operation->volume_ids[operation->num_volumes] = argv[++i];
+			operation->roots[operation->num_volumes] = argv[++i];
+			operation->num_volumes++;
+			continue;
+		}
+		if (i + 1 >= argc) {
+			return -1;
+		}
+		value = argv[++i];
+		if (strcmp(name, "--receipt") == 0) operation->receipt = value;
+		else if (strcmp(name, "--status") == 0) operation->status = value;
+		else if (strcmp(name, "--source-release") == 0) operation->source_release = value;
+		else if (strcmp(name, "--backend") == 0) operation->backend = value;
+		else if (strcmp(name, "--device-id") == 0) operation->device_id = value;
+		else if (strcmp(name, "--payload-id") == 0) operation->payload_id = value;
+		else if (strcmp(name, "--tdb") == 0) operation->tdb = value;
+		else if (strcmp(name, "--source-version") == 0) {
+			char *end;
+			errno = 0;
+			operation->source_version = strtoul(value, &end, 10);
+			if (errno != 0 || value[0] == '-' || *value == '\0' || *end != '\0') return -1;
+		} else return -1;
+	}
+	if (!tc_receipt_value_valid(operation->receipt) ||
+	    !tc_receipt_value_valid(operation->status) ||
+	    !tc_receipt_value_valid(operation->source_release) ||
+	    !tc_receipt_value_valid(operation->backend) ||
+	    !tc_receipt_value_valid(operation->device_id) ||
+	    !tc_receipt_value_valid(operation->payload_id) ||
+	    !tc_receipt_value_valid(operation->tdb) ||
+	    operation->num_volumes == 0 ||
+	    (strcmp(operation->backend, "stream") != 0 &&
+	     strcmp(operation->backend, "netatalk") != 0))
+	{
+		return -1;
+	}
+	for (i = 0; i < (int)operation->num_volumes; i++) {
+		if (!tc_receipt_value_valid(operation->volume_ids[i]) ||
+		    !tc_receipt_value_valid(operation->roots[i])) return -1;
+	}
+	return 0;
+}
+
+static int tc_redirect_maintenance_log(const char *status_path)
+{
+	char log_path[PATH_MAX];
+	int null_fd;
+	int log_fd;
+
+	if (snprintf(log_path, sizeof(log_path), "%s.log", status_path) >=
+	    (int)sizeof(log_path)) return -1;
+	null_fd = open("/dev/null", O_RDONLY);
+	log_fd = open(log_path, O_WRONLY | O_CREAT | O_APPEND, 0600);
+	if (null_fd == -1 || log_fd == -1 || dup2(null_fd, STDIN_FILENO) == -1 ||
+	    dup2(log_fd, STDOUT_FILENO) == -1 || dup2(log_fd, STDERR_FILENO) == -1)
+	{
+		if (null_fd != -1) close(null_fd);
+		if (log_fd != -1) close(log_fd);
+		return -1;
+	}
+	close(null_fd);
+	close(log_fd);
+	return 0;
+}
+
+static int tc_run_combined_child(const char *program,
+				 const struct tc_maintenance *operation)
+{
+	char **arguments = calloc(5 + operation->num_volumes, sizeof(char *));
+	pid_t child;
+	int status;
+	size_t i;
+
+	if (arguments == NULL) return -1;
+	arguments[0] = (char *)program;
+	arguments[1] = "combined";
+	arguments[2] = access(operation->tdb, F_OK) == 0 ? (char *)operation->tdb : "-";
+	arguments[3] = (char *)operation->backend;
+	for (i = 0; i < operation->num_volumes; i++) arguments[4 + i] = (char *)operation->roots[i];
+	child = fork();
+	if (child == -1) {
+		free(arguments);
+		return -1;
+	}
+	if (child == 0) {
+		setenv("TC_XATTR_STATUS_PATH", operation->status, 1);
+		setenv("TC_XATTR_OPERATION_ID", tc_operation_id, 1);
+		execv(program, arguments);
+		_exit(127);
+	}
+	tc_migration_child = child;
+	while (waitpid(child, &status, 0) == -1) {
+		if (errno != EINTR) {
+			tc_migration_child = 0;
+			free(arguments);
+			return -1;
+		}
+	}
+	tc_migration_child = 0;
+	free(arguments);
+	return WIFEXITED(status) ? WEXITSTATUS(status) : 128;
+}
+
+static void tc_read_status_counts(const char *path, uint64_t *entries,
+				  uint64_t *conversions, uint64_t *warnings,
+				  uint64_t *errors)
+{
+	char line[128];
+	FILE *file = fopen(path, "r");
+
+	*entries = *conversions = *warnings = *errors = 0;
+	if (file == NULL) return;
+	while (fgets(line, sizeof(line), file) != NULL) {
+		(void)sscanf(line, "entries=%"SCNu64, entries);
+		(void)sscanf(line, "conversions=%"SCNu64, conversions);
+		(void)sscanf(line, "warnings=%"SCNu64, warnings);
+		(void)sscanf(line, "errors=%"SCNu64, errors);
+	}
+	fclose(file);
+}
+
+static int tc_maintenance_worker(const char *program,
+				 const struct tc_maintenance *operation,
+				 int ready_fd)
+{
+	int lock_fd;
+	int migration_status;
+	char operation_id[32];
+	char ready = '1';
+	const char *terminal;
+	uint64_t entries, conversions, warnings, errors;
+
+	if (setsid() == -1 || tc_redirect_maintenance_log(operation->status) != 0) {
+		return 1;
+	}
+	lock_fd = tc_lock_operation();
+	if (lock_fd == -1) {
+		ready = '0';
+		(void)write(ready_fd, &ready, 1);
+		return 1;
+	}
+	snprintf(operation_id, sizeof(operation_id), "%ld", (long)getpid());
+	tc_operation_id = operation_id;
+	tc_live_status_path = operation->status;
+	signal(SIGTERM, tc_stop_handler);
+	signal(SIGINT, tc_stop_handler);
+	if (tc_write_status("running", "offline_transition", 0, 0, 0, 0, "") != 0 ||
+	    tc_write_receipt(operation, "incomplete") != 0)
+	{
+		ready = '0';
+		(void)write(ready_fd, &ready, 1);
+		close(lock_fd);
+		return 1;
+	}
+	(void)write(ready_fd, &ready, 1);
+	close(ready_fd);
+	if (tc_disable_legacy_startup() != 0 || tc_stop_legacy_writers() != 0) {
+		(void)tc_write_status("failed", "offline_transition", 0, 0, 0, 1,
+			"legacy_writers_not_stopped");
+		close(lock_fd);
+		return 1;
+	}
+	(void)tc_write_status("running", "convert", 0, 0, 0, 0, "");
+	migration_status = tc_run_combined_child(program, operation);
+	tc_read_status_counts(operation->status, &entries, &conversions,
+		&warnings, &errors);
+	if (migration_status == 0 && !tc_stop_requested) {
+		sync();
+		if (tc_write_receipt(operation, "complete") == 0) {
+			(void)tc_write_status("complete", "finished", entries,
+				conversions, warnings, errors,
+				"selected_scope_complete");
+			close(lock_fd);
+			return 0;
+		}
+	}
+	terminal = tc_stop_requested ? "cancelled" : "failed";
+	(void)tc_write_status(terminal, "incomplete", entries, conversions,
+		warnings, errors + 1,
+		tc_stop_requested ? "cancelled_at_file_boundary" : "conversion_failed");
+	close(lock_fd);
+	return 1;
+}
+
+static int tc_start_maintenance(TALLOC_CTX *mem_ctx, const char *program,
+				int argc, char **argv)
+{
+	struct tc_maintenance operation;
+	int ready_pipe[2];
+	pid_t child;
+	char ready;
+
+	if (tc_parse_maintenance(mem_ctx, argc, argv, &operation) != 0 ||
+	    pipe(ready_pipe) != 0)
+	{
+		return 2;
+	}
+	child = fork();
+	if (child == -1) return 3;
+	if (child == 0) {
+		close(ready_pipe[0]);
+		_exit(tc_maintenance_worker(program, &operation, ready_pipe[1]));
+	}
+	close(ready_pipe[1]);
+	if (read(ready_pipe[0], &ready, 1) != 1 || ready != '1') {
+		close(ready_pipe[0]);
+		return 3;
+	}
+	close(ready_pipe[0]);
+	printf("state=running\noperation_id=%ld\nphase=offline_transition\n",
+		(long)child);
+	return 0;
+}
+
+static int tc_print_file(const char *path)
+{
+	char buffer[4096];
+	int fd = open(path, O_RDONLY);
+	ssize_t got;
+
+	if (fd == -1) return -1;
+	while ((got = read(fd, buffer, sizeof(buffer))) > 0) {
+		if (write(STDOUT_FILENO, buffer, got) != got) {
+			close(fd);
+			return -1;
+		}
+	}
+	close(fd);
+	return got < 0 ? -1 : 0;
+}
