+static int tc_disable_legacy_startup(void)
+{
+	int dir_fd = open("/mnt/Flash", O_RDONLY);
+
+	if (dir_fd == -1) {
+		return -1;
+	}
+	if (unlink("/mnt/Flash/rc.local") != 0 && errno != ENOENT) {
+		close(dir_fd);
+		return -1;
+	}
+	if (tc_fsync_directory_or_sync(dir_fd) != 0) {
+		close(dir_fd);
+		return -1;
+	}
+	close(dir_fd);
+	return 0;
+}
+
+static int tc_lock_operation(void)
+{
+	struct flock lock;
+	int fd = open(TC_OPERATION_LOCK, O_RDWR | O_CREAT, 0600);
+
+	if (fd == -1) {
+		return -1;
+	}
+	ZERO_STRUCT(lock);
+	lock.l_type = F_WRLCK;
+	lock.l_whence = SEEK_SET;
+	if (fcntl(fd, F_SETLK, &lock) != 0) {
+		close(fd);
+		return -1;
+	}
+	return fd;
+}
