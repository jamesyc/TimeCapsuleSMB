+	size_t num_volumes;
+};
+
+static bool tc_receipt_value_valid(const char *value)
+{
+	return value != NULL && value[0] != '\0' && strchr(value, '\n') == NULL &&
+		strchr(value, '\r') == NULL;
+}
+
+static int tc_write_receipt(const struct tc_maintenance *operation,
+			    const char *state)
+{
+	char temporary[PATH_MAX];
+	const char *slash;
+	char directory[PATH_MAX];
+	int fd = -1;
+	int dir_fd = -1;
+	size_t i;
+	int result = -1;
+
+	if (snprintf(temporary, sizeof(temporary), "%s.new", operation->receipt) >=
+	    (int)sizeof(temporary))
+	{
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	slash = strrchr(operation->receipt, '/');
+	if (slash == NULL || slash == operation->receipt ||
+	    (size_t)(slash - operation->receipt) >= sizeof(directory))
+	{
+		errno = EINVAL;
+		return -1;
+	}
+	memcpy(directory, operation->receipt, slash - operation->receipt);
+	directory[slash - operation->receipt] = '\0';
+	unlink(temporary);
+	fd = open(temporary, O_WRONLY | O_CREAT | O_EXCL, 0600);
+	if (fd == -1) {
+		goto out;
+	}
+	if (dprintf(fd,
+		"format=1\nmigration=1\nstate=%s\nsource_release=%s\n"
+		"source_version_code=%lu\nsource_backend=%s\n"
+		"device_identity=%s\npayload_identity=%s\n",
+		state, operation->source_release, operation->source_version,
+		operation->backend, operation->device_id, operation->payload_id) < 0)
+	{
+		goto out;
+	}
+	for (i = 0; i < operation->num_volumes; i++) {
+		if (dprintf(fd, "volume=%s\n", operation->volume_ids[i]) < 0) {
+			goto out;
+		}
+	}
+	if (fsync(fd) != 0 || close(fd) != 0) {
+		fd = -1;
+		goto out;
+	}
+	fd = -1;
+	dir_fd = open(directory, O_RDONLY);
+	if (dir_fd == -1 || rename(temporary, operation->receipt) != 0 ||
+	    tc_fsync_directory_or_sync(dir_fd) != 0)
+	{
+		goto out;
+	}
+	result = 0;
+out:
+	if (fd != -1) {
+		close(fd);
+	}
+	if (dir_fd != -1) {
+		close(dir_fd);
+	}
+	if (result != 0) {
+		unlink(temporary);
+	}
+	return result;
+}
+
+static int tc_wait_command(char *const command[])
+{
+	pid_t child = fork();
+	int status;
+
+	if (child == -1) {
+		return -1;
+	}
+	if (child == 0) {
+		execv(command[0], command);
+		_exit(127);
+	}
+	while (waitpid(child, &status, 0) == -1) {
+		if (errno != EINTR) {
+			return -1;
+		}
+	}
+	return WIFEXITED(status) ? WEXITSTATUS(status) : 128;
+}
+
+static int tc_pkill(const char *signal_name, const char *option,
+		    const char *pattern)
+{
+	char *const command[] = {
+		"/usr/bin/pkill", (char *)signal_name, (char *)option,
+		(char *)pattern, NULL
+	};
+	int result = tc_wait_command(command);
+
+	return result == 0 || result == 1 ? 0 : -1;
+}
