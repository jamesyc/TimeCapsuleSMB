diff --git a/lib/replace/replace.h b/lib/replace/replace.h
--- a/lib/replace/replace.h
+++ b/lib/replace/replace.h
@@ -1156,6 +1156,7 @@ extern const char hexchars_upper[];
 # ifdef HAVE_PTHREAD
 # error Configure failed to detect pthread library with missing TLS support
 # endif
+#define __thread
 #define HAVE___THREAD
 #endif
 
diff --git a/lib/replace/wscript b/lib/replace/wscript
--- a/lib/replace/wscript
+++ b/lib/replace/wscript
@@ -647,10 +647,18 @@ syscall(SYS_copy_file_range,0,NULL,0,NULL,0,0);
        conf.undefine('HAVE_DGETTEXT')
        conf.undefine('HAVE_DECL_DGETTEXT')
 
-    conf.CHECK_FUNCS_IN('pthread_create', 'pthread', checklibc=True, headers='pthread.h')
+    # The top-level wscript sets NO_PTHREADS for --disable-pthread. Skip
+    # every pthread probe then: 'disabled' is not 'error', so none of the
+    # checks below runs and HAVE_PTHREAD stays undefined.
+    no_pthreads = bool(conf.env.NO_PTHREADS)
+    if no_pthreads:
+        conf.SET_TARGET_TYPE('pthread', 'EMPTY')
+        conf.msg('Checking for pthread support', 'disabled by --disable-pthread')
+    else:
+        conf.CHECK_FUNCS_IN('pthread_create', 'pthread', checklibc=True, headers='pthread.h')
 
     PTHREAD_CFLAGS='error'
-    PTHREAD_LDFLAGS='error'
+    PTHREAD_LDFLAGS='disabled' if no_pthreads else 'error'
 
     if PTHREAD_LDFLAGS == 'error':
         # Check if pthread_attr_init() is provided by libc first!
@@ -722,6 +730,12 @@ syscall(SYS_copy_file_range,0,NULL,0,NULL,0,0);
         'HAVE___THREAD',
         addmain=False,
         msg='Checking for __thread local storage')
+    if no_pthreads:
+        # Without threads, thread-local storage is process storage. Leave
+        # HAVE___THREAD unset so replace.h defines __thread away: the static
+        # appliance links Samba's -fPIC objects, whose TLS accesses call
+        # __tls_get_addr, and static libc's __tls_get_addr only aborts.
+        conf.undefine('HAVE___THREAD')
 
     if conf.CONFIG_SET('HAVE_PTHREAD') and not conf.CONFIG_SET('HAVE___THREAD'):
         conf.fatal('Missing required TLS support in pthread library')
diff --git a/wscript b/wscript
--- a/wscript
+++ b/wscript
@@ -74,6 +74,7 @@ def options(opt):
 # It also ensures our container image generation in bootstrap/ is correct
 # as otherwise a missing package there would just silently work
 
+    opt.samba_add_onoff_option('pthread', with_name="enable", without_name="disable", default=True)
     opt.samba_add_onoff_option('pthreadpool', with_name="enable", without_name="disable", default=True)
 
     opt.add_option('--with-system-mitkrb5',
@@ -192,7 +193,11 @@ def configure(conf):
 
     conf.ADD_EXTRA_INCLUDES('#include/public #source4 #lib #source4/lib #source4/include #include #lib/replace')
 
-    conf.env.replace_add_global_pthread = True
+    # Time Capsule appliance kernels cannot use Samba's pthread paths. Record
+    # the choice before libreplace probes pthread and constructs dependencies.
+    conf.env.NO_PTHREADS = not getattr(
+        Options.options, 'with_pthread', True)
+    conf.env.replace_add_global_pthread = not conf.env.NO_PTHREADS
     conf.RECURSE('lib/replace')
 
     conf.RECURSE('examples/fuse')
