-        msg='Checking for __thread local storage')
+    if no_pthreads:
+        # Without threads, thread-local storage is process storage. Leave
+        # HAVE___THREAD unset so replace.h defines __thread away: the static
+        # appliance links Samba's -fPIC objects, whose TLS accesses call
+        # __tls_get_addr, and static libc's __tls_get_addr only aborts.
+        conf.msg('Checking for __thread local storage', 'disabled by --disable-pthread')
+    else:
+        conf.CHECK_CODE('''
+            __thread int tls;
+
+            int main(void) {
+                return 0;
+            }
+            ''',
+            'HAVE___THREAD',
+            addmain=False,
+            msg='Checking for __thread local storage')
 
     if conf.CONFIG_SET('HAVE_PTHREAD') and not conf.CONFIG_SET('HAVE___THREAD'):
