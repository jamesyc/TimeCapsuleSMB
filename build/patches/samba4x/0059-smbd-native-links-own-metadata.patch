 	}
 
+	if (fsp_get_pathref_fd(fsp) == -1) {
+		ret = CATIA_FETCH_FSP_PRE_NEXT(talloc_tos(), handle, fsp, &cc);
+		if (ret != 0) {
+			TALLOC_FREE(mapped_name);
+			return -1;
+		}
+	}
+
 	ret = SMB_VFS_NEXT_FREMOVEXATTR(handle, fsp, mapped_name);
 
+	CATIA_FETCH_FSP_POST_NEXT(&cc, fsp);
 	TALLOC_FREE(mapped_name);
 
 	return ret;
@@ -1306,6 +1360,7 @@ static int catia_fsetxattr(struct vfs_handle_struct *handle,
 			   size_t size,
 			   int flags)
 {
+	struct catia_cache *cc = NULL;
 	char *mapped_xattr_name = NULL;
 	int ret;
 
@@ -1318,9 +1373,18 @@ static int catia_fsetxattr(struct vfs_handle_struct *handle,
 		return -1;
 	}
 
+	if (fsp_get_pathref_fd(fsp) == -1) {
+		ret = CATIA_FETCH_FSP_PRE_NEXT(talloc_tos(), handle, fsp, &cc);
+		if (ret != 0) {
+			TALLOC_FREE(mapped_xattr_name);
+			return -1;
+		}
+	}
+
 	ret = SMB_VFS_NEXT_FSETXATTR(handle, fsp, mapped_xattr_name,
 				     value, size, flags);
 
+	CATIA_FETCH_FSP_POST_NEXT(&cc, fsp);
 	TALLOC_FREE(mapped_xattr_name);
 
 	return ret;
