+/* Only canonical Apple streams omit the marker in physical HFS storage.
+ * Windows ADS must retain their existing 3,802-byte extent layout. */
+static bool streams_xattr_native_apple(const struct streams_xattr_config *config,
+				     const char *name)
+{
+	size_t len = strlen(name);
+	const char *suffix = ":$DATA";
+
+	return config->native_hfs && len > strlen(suffix) &&
+		strncmp(name, "com.apple.", 10) == 0 &&
+		strcmp(name + len - strlen(suffix), suffix) == 0 &&
+		strcmp(name, "com.apple.FinderInfo:$DATA") != 0 &&
+		strcmp(name, "com.apple.ResourceFork:$DATA") != 0;
+}
