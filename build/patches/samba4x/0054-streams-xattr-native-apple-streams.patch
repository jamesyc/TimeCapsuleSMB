+static void streams_xattr_replace_done(struct stream_io *sio)
+{
+	sio->replacing = false;
+	TALLOC_FREE(sio->replaced);
+}
+
+/*
+ * A Mac replaces an xattr by opening its stream with overwrite and writing it.
+ * smbd truncates the stream after the open, but one HFS attribute may not hold
+ * the new value, which fsetxattr_multi() refuses only when the write comes. AFP
+ * sets an attribute in one call, so a refusal leaves what was there: put that
+ * back, or remove the stream this handle created. Called with errno set, on a
+ * set that failed for any reason.
+ *
+ * A handle is replacing from the truncate to 0 or its creation of the stream
+ * until the first of:
+ * - it stores data: the client was told that worked, so nothing is undone;
+ * - a set fails: this function, once;
+ * - close.
+ *
+ * Another writer, AFP above all, can store or remove the attribute at any time,
+ * and no lock keeps AFP out. So undo only an attribute still empty, as this
+ * handle left it; a change in the moment between that check and the restore
+ * is lost, which takes AFP landing in those few instructions.
+ */
+static void streams_xattr_undo_replace(
+	const struct streams_xattr_config *config,
+	struct stream_io *sio)
+{
+	int error = errno;
+	char *val = NULL;
+	int ret;
+
+	if (!sio->replacing) {
+		return;
+	}
+	ret = streams_xattr_get_ea_value_fsp(talloc_tos(),
+					     config,
+					     sio->fsp->base_fsp,
+					     sio->raw_stream_name,
+					     &val);
+	if (ret != 0 || talloc_get_size(val) != 1) {
+		DBG_NOTICE("xattr [%s] on file [%s] changed since this handle "
+			   "emptied it; leaving it\n",
+			   sio->xattr_name, sio->base);
+	} else {
+		if (sio->replaced != NULL) {
+			ret = fsetxattr_multi(config,
+					      sio->fsp->base_fsp,
+					      sio->raw_stream_name,
+					      sio->replaced,
+					      talloc_get_size(sio->replaced),
+					      0);
+		} else {
+			ret = fremovexattr_multi(config,
+						 sio->fsp->base_fsp,
+						 sio->raw_stream_name);
+		}
+		if (ret != 0) {
+			DBG_ERR("restoring xattr [%s] on file [%s] failed: %s\n",
+				sio->xattr_name, sio->base, strerror(errno));
+		}
+	}
+	TALLOC_FREE(val);
+	streams_xattr_replace_done(sio);
+	errno = error;
+}
