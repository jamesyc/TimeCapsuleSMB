+/*
+ * Only a Mac's com.apple.* streams are stored as one native attribute
+ * without the extent count byte; Windows streams keep the extent layout.
+ */
+static bool streams_xattr_native_apple(const struct streams_xattr_config *config,
+				       const char *name)
+{
+	size_t native_len;
+
+	if (!config->native_hfs) {
+		return false;
+	}
+	native_len = tc_apple_stream_native_len(name);
+	return native_len != 0 && !tc_fruit_owned_xattr(name, native_len);
+}
