+		 * Nothing else would ever delete this lease record.
+		 */
+		if (e.op_type == LEASE_OPLOCK) {
+			remove_lease_if_stale(lck, &e.client_guid, &e.lease_key);
+		}
 	}
 	if (fsp_get_pathref_fd(fsp) != -1) {
 		NTSTATUS close_status;
diff --git a/source3/smbd/smb2_create.c b/source3/smbd/smb2_create.c
--- a/source3/smbd/smb2_create.c
+++ b/source3/smbd/smb2_create.c
@@ -24,6 +24,7 @@
 #include "smbd/smbd.h"
 #include "smbd/globals.h"
 #include "smbd/smbXsrv_open.h"
+#include "smbd/scavenger.h"
 #include "../libcli/smb/smb_common.h"
 #include "../librpc/gen_ndr/ndr_security.h"
 #include "../librpc/gen_ndr/ndr_smb2_lease_struct.h"
@@ -1184,6 +1185,25 @@ static struct tevent_req *smbd_smb2_create_send(TALLOC_CTX *mem_ctx,
 				   nt_errstr(status),
 				   nt_errstr(return_status));
 
+			/*
+			 * smb2srv_open_recreate() stored the open as ours.
+			 * Store it disconnected again with its own disconnect
+			 * time and tell the scavenger, as close_durable() does.
+			 * Freeing the op alone stores it with disconnect time
+			 * 0, and the scavenger may have run its timer while
+			 * this reconnect held the open, or found it ours when
+			 * its disconnect message arrived: nothing would expire
+			 * it.
+			 */
+			status = smbXsrv_open_close(
+				state->op, state->op->global->disconnect_time);
+			if (NT_STATUS_IS_OK(status)) {
+				scavenger_schedule_disconnected(
+					smb1req->sconn->msg_ctx,
+					state->op->global->open_persistent_id,
+					&state->op->global->file_id,
+					state->op->global->name_hash);
+			}
 			TALLOC_FREE(state->op);
 			tevent_req_nterror(req, return_status);
 			return tevent_req_post(req, state->ev);
