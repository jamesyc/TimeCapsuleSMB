diff --git a/source3/locking/brlock.c b/source3/locking/brlock.c
--- a/source3/locking/brlock.c
+++ b/source3/locking/brlock.c
@@ -1508,6 +1508,37 @@ bool brl_reconnect_disconnected(struct files_struct *fsp,
 	return true;
 }
 
+/*
+ * Undo brl_reconnect_disconnected() for a durable reconnect that failed
+ * after it. The open has lost its share mode entry, so nothing can
+ * reconnect it again, and its locks now belong to this live smbd, which
+ * brl_cleanup_disconnected() never touches: they would block every other
+ * client for as long as this connection lasts. Drop them the way
+ * brl_cleanup_disconnected() does. The reconnect took no POSIX locks, so
+ * only the records go.
+ */
+void brl_drop_reconnected(struct files_struct *fsp,
+			  struct byte_range_lock *br_lck)
+{
+	uint32_t tid = fsp->conn->cnum;
+	uint64_t fnum = fsp->fnum;
+	struct server_id self = messaging_server_id(fsp->conn->sconn->msg_ctx);
+	unsigned int i;
+
+	for (i = 0; i < br_lck->num_locks; i++) {
+		struct lock_struct *lock = &br_lck->lock_data[i];
+
+		if (lock->context.tid != tid || lock->fnum != fnum ||
+		    !server_id_equal(&lock->context.pid, &self)) {
+			continue;
+		}
+		/* Deleted in byte_range_lock_flush(). */
+		lock->context.pid.pid = 0;
+		br_lck->modified = true;
+	}
+	fsp->current_lock_count = 0;
+}
+
 struct brl_forall_cb {
 	void (*fn)(struct file_id id, struct server_id pid,
 		   enum brl_type lock_type,
