diff --git a/lib/util/time.c b/lib/util/time.c
--- a/lib/util/time.c
+++ b/lib/util/time.c
@@ -844,6 +844,23 @@ struct timespec nt_time_to_unix_timespec_raw(
 	/* Now adjust by 369 years to make the secs since 1970 */
 	d -= TIME_FIXUP_CONSTANT_INT;
 
+	/*
+	 * A 32-bit time_t cannot hold every NTTIME. Saturate instead of
+	 * letting the cast wrap, so the callers' TIME_T_MAX and TIME_T_MIN
+	 * checks see a time out of range: 2040 must not become 1903.
+	 */
+	/* Both appliance ABIs use signed time_t. The 64-bit ABI holds the
+	 * entire converted range; use explicit 32-bit limits for the other
+	 * ABI, since _TYPE_MINIMUM shifts signed -1 (undefined in C).
+	 */
+	if (sizeof(time_t) == 4 && d > INT32_MAX) {
+		d = INT32_MAX;
+		ret.tv_nsec = 0;
+	} else if (sizeof(time_t) == 4 && d < INT32_MIN) {
+		d = INT32_MIN;
+		ret.tv_nsec = 0;
+	}
+
 	ret.tv_sec = (time_t)d;
 	return ret;
 }
