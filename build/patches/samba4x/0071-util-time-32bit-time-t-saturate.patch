diff --git a/lib/util/time.c b/lib/util/time.c
--- a/lib/util/time.c
+++ b/lib/util/time.c
@@ -844,6 +844,23 @@ struct timespec nt_time_to_unix_timespec_raw(
 	/* Now adjust by 369 years to make the secs since 1970 */
 	d -= TIME_FIXUP_CONSTANT_INT;
 
+	/*
+	 * Where time_t is 32 bits the cast below would wrap a time out of
+	 * its range (2040 would become 1903). Saturate first, so that the
+	 * callers' TIME_T_MIN and TIME_T_MAX checks see it as out of range.
+	 * This uses INT32_MIN and INT32_MAX rather than _TYPE_MINIMUM(time_t),
+	 * which shifts a signed -1 (undefined in C), and so assumes that a
+	 * 32-bit time_t is signed; a 64-bit one holds the whole converted
+	 * range.
+	 */
+	if (sizeof(time_t) == 4 && d > INT32_MAX) {
+		d = INT32_MAX;
+		ret.tv_nsec = 0;
+	} else if (sizeof(time_t) == 4 && d < INT32_MIN) {
+		d = INT32_MIN;
+		ret.tv_nsec = 0;
+	}
+
 	ret.tv_sec = (time_t)d;
 	return ret;
 }
