+++ b/source3/smbd/close.c
@@ -917,6 +917,9 @@ static bool close_durable(struct smb_request *req,
 	 * This is the case where we successfully disconnected
 	 * a durable handle and closed the underlying file.
 	 */
+	DBG_NOTICE("tc_reconnect: durable open %#" PRIx64 " disconnected: "
+		   "%s\n", fsp->op->global->open_persistent_id,
+		   fsp_str_dbg(fsp));
 
 	DBG_DEBUG("%s disconnected durable handle for file %s\n",
 		  fsp->conn->session_info->unix_info->unix_name,
diff --git a/source3/smbd/smb2_create.c b/source3/smbd/smb2_create.c
--- a/source3/smbd/smb2_create.c
+++ b/source3/smbd/smb2_create.c
@@ -1118,6 +1118,20 @@ static struct tevent_req *smbd_smb2_create_send(TALLOC_CTX *mem_ctx,
 		 */
 		SMB_ASSERT(state->op == NULL);
 
+		{
+			struct GUID_txt_buf guid_buf;
+
+			/* Durable reconnect diagnostics (patch 0061). A v1
+			 * reconnect has no create GUID. */
+			DBG_NOTICE("tc_reconnect: reconnect %s persistent=%#"
+				   PRIx64 " create_guid=%s session=%#" PRIx64
+				   "\n", state->fname,
+				   state->persistent_id,
+				   state->create_guid == NULL ? "none" :
+				   GUID_buf_string(state->create_guid,
+						   &guid_buf),
+				   smb2req->session->global->session_wire_id);
+		}
 		if (state->lease_ptr != NULL) {
 			lease_key = &state->lease_ptr->lease_key;
 		}
@@ -1189,6 +1203,8 @@ static struct tevent_req *smbd_smb2_create_send(TALLOC_CTX *mem_ctx,
 			return tevent_req_post(req, state->ev);
 		}
 
+		DBG_NOTICE("tc_reconnect: reconnect %s persistent=%#" PRIx64
+			   " restored\n", state->fname, state->persistent_id);
 		DBG_DEBUG("oplock_type=%u, lease_ptr==%p\n",
 			  (unsigned)state->result->oplock_type, state->lease_ptr);
 
