 	status = smb2srv_session_lookup_client(client,
 					       close_info->old_session_wire_id,
@@ -429,6 +433,8 @@ static void smbXsrv_session_close_shutdown_done(struct tevent_req *subreq)
 			session->global->session_wire_id,
 			nt_errstr(status));
 	}
+	DBG_NOTICE("tc_reconnect: closed session %#" PRIx64 ": %s\n",
+		   session->global->session_wire_id, nt_errstr(status));
 
 	TALLOC_FREE(session);
 }
@@ -1029,18 +1035,29 @@ struct tevent_req *smb2srv_session_close_previous_send(TALLOC_CTX *mem_ctx,
 
 	tevent_req_set_cleanup_fn(req, smb2srv_session_close_previous_cleanup);
 
+	/*
+	 * Durable reconnect diagnostics (patch 0061): every way the previous
+	 * session can be left alone is logged, since a session left open keeps
+	 * its durable opens attached and the client's reconnect then fails.
+	 */
 	if (global_zeros != 0) {
+		DBG_NOTICE("tc_reconnect: previous %#" PRIx64 " not ours "
+			   "(high bits set)\n", previous_session_id);
 		tevent_req_done(req);
 		return tevent_req_post(req, ev);
 	}
 
 	if (session_info == NULL) {
+		DBG_NOTICE("tc_reconnect: previous %#" PRIx64 " kept: "
+			   "no session info\n", previous_session_id);
 		tevent_req_done(req);
 		return tevent_req_post(req, ev);
 	}
 	current_token = session_info->security_token;
 
 	if (current_token->num_sids <= PRIMARY_USER_SID_INDEX) {
+		DBG_NOTICE("tc_reconnect: previous %#" PRIx64 " kept: "
+			   "no user SID\n", previous_session_id);
 		tevent_req_done(req);
 		return tevent_req_post(req, ev);
 	}
@@ -1048,6 +1065,8 @@ struct tevent_req *smb2srv_session_close_previous_send(TALLOC_CTX *mem_ctx,
 
 	if (!security_token_has_nt_authenticated_users(current_token)) {
 		/* TODO */
+		DBG_NOTICE("tc_reconnect: previous %#" PRIx64 " kept: "
+			   "not an authenticated user\n", previous_session_id);
 		tevent_req_done(req);
 		return tevent_req_post(req, ev);
 	}
@@ -1057,6 +1076,8 @@ struct tevent_req *smb2srv_session_close_previous_send(TALLOC_CTX *mem_ctx,
 							global_id,
 							state /* TALLOC_CTX */);
 	if (state->db_rec == NULL) {
+		DBG_NOTICE("tc_reconnect: previous %#" PRIx64 " record "
+			   "cannot be locked\n", previous_session_id);
 		tevent_req_nterror(req, NT_STATUS_UNSUCCESSFUL);
 		return tevent_req_post(req, ev);
 	}
@@ -1094,11 +1115,16 @@ static void smb2srv_session_close_previous_check(struct tevent_req *req)
 					     &seqnum);
 
 	if (is_free) {
+		DBG_NOTICE("tc_reconnect: previous %#" PRIx64 " is gone\n",
+			   state->previous_session_id);
 		tevent_req_done(req);
 		return;
 	}
 
 	if (global->auth_session_info == NULL) {
+		DBG_NOTICE("tc_reconnect: previous %#" PRIx64 " kept: "
+			   "not authenticated yet\n",
+			   state->previous_session_id);
 		tevent_req_done(req);
 		return;
 	}
@@ -1106,6 +1132,8 @@ static void smb2srv_session_close_previous_check(struct tevent_req *req)
 	previous_token = global->auth_session_info->security_token;
 
 	if (!security_token_is_sid(previous_token, state->current_sid)) {
+		DBG_NOTICE("tc_reconnect: previous %#" PRIx64 " kept: "
+			   "another user\n", state->previous_session_id);
 		tevent_req_done(req);
 		return;
 	}
@@ -1166,6 +1194,16 @@ static void smb2srv_session_close_previous_check(struct tevent_req *req)
 		return;
 	}
 
+	{
+		struct server_id_buf id_buf;
+
+		DBG_NOTICE("tc_reconnect: previous %#" PRIx64 " owned by %s: "
+			   "asking it to close for %#" PRIx64 "\n",
+			   state->previous_session_id,
+			   server_id_str_buf(global->channels[0].server_id,
+					     &id_buf),
+			   state->current_session_id);
+	}
 	status = messaging_send(conn->client->msg_ctx,
 				global->channels[0].server_id,
 				MSG_SMBXSRV_SESSION_CLOSE, &blob);
@@ -1192,6 +1230,8 @@ static void smb2srv_session_close_previous_modified(struct tevent_req *subreq)
 
 	status = dbwrap_watched_watch_recv(subreq, &instance, NULL, NULL);
 	TALLOC_FREE(subreq);
+	DBG_NOTICE("tc_reconnect: previous %#" PRIx64 " record changed: %s\n",
+		   state->previous_session_id, nt_errstr(status));
 	if (tevent_req_nterror(req, status)) {
 		return;
 	}
