+		   state->in_previous_session_id);
 	if ((state->in_previous_session_id != 0) &&
 	     (state->session->global->session_wire_id !=
 	      state->in_previous_session_id))
diff --git a/source3/smbd/smbXsrv_session.c b/source3/smbd/smbXsrv_session.c
--- a/source3/smbd/smbXsrv_session.c
+++ b/source3/smbd/smbXsrv_session.c
@@ -322,6 +322,10 @@ static void smbXsrv_session_close_loop(struct tevent_req *subreq)
 		NDR_PRINT_DEBUG(smbXsrv_session_closeB, &close_blob);
 		goto next;
 	}
+	DBG_NOTICE("tc_reconnect: asked to close session %#" PRIx64
+		   " for new session %#" PRIx64 "\n",
+		   close_info->old_session_wire_id,
