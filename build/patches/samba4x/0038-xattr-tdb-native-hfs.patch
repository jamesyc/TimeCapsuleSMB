diff --git a/source3/modules/vfs_xattr_tdb.c b/source3/modules/vfs_xattr_tdb.c
--- a/source3/modules/vfs_xattr_tdb.c
+++ b/source3/modules/vfs_xattr_tdb.c
@@ -25,12 +25,14 @@
 #include "dbwrap/dbwrap_open.h"
 #include "source3/lib/xattr_tdb.h"
 #include "lib/util/tevent_unix.h"
+#include "airport_native_xattr.h"
 
 #undef DBGC_CLASS
 #define DBGC_CLASS DBGC_VFS
 
 struct xattr_tdb_config {
 	struct db_context *db;
+	bool native_hfs;
 	bool ignore_user_xattr;
 };
 
@@ -45,6 +47,8 @@ static bool is_user_xattr(const char *xattr_name)
 	return (match == 0);
 }
 
+#include "tc_xattr_tdb_native.c"
+
 struct xattr_tdb_getxattrat_state {
 	struct vfs_aio_state vfs_aio_state;
 	ssize_t xattr_size;
@@ -109,6 +113,36 @@ static struct tevent_req *xattr_tdb_getxattrat_send(
 	}
 
 
+	if (config->native_hfs) {
+		ssize_t xattr_size = tc_xattr_tdb_native_get(
+			smb_fname->fsp, xattr_name, NULL, 0);
+
+		if (xattr_size > 0 && alloc_hint != 0) {
+			if ((size_t)xattr_size > alloc_hint) {
+				errno = ERANGE;
+				xattr_size = -1;
+			} else {
+				state->xattr_value = talloc_array(
+					state, uint8_t, xattr_size);
+				if (tevent_req_nomem(state->xattr_value, req)) {
+					TALLOC_FREE(smb_fname);
+					return tevent_req_post(req, ev);
+				}
+				xattr_size = tc_xattr_tdb_native_get(
+					smb_fname->fsp, xattr_name,
+					state->xattr_value, xattr_size);
+			}
+		}
+		TALLOC_FREE(smb_fname);
+		if (xattr_size < 0) {
+			tevent_req_error(req, errno);
+			return tevent_req_post(req, ev);
+		}
+		state->xattr_size = xattr_size;
+		tevent_req_done(req);
+		return tevent_req_post(req, ev);
+	}
+
 	id = SMB_VFS_NEXT_FILE_ID_CREATE(handle, &smb_fname->st);
 
 	TALLOC_FREE(smb_fname);
@@ -216,6 +250,9 @@ static ssize_t xattr_tdb_fgetxattr(struct vfs_handle_struct *handle,
 	if (!xattr_tdb_init(handle, &config)) {
 		return -1;
 	}
+	if (config->native_hfs) {
+		return tc_xattr_tdb_native_get(fsp, name, value, size);
+	}
 
 	if (config->ignore_user_xattr && is_user_xattr(name)) {
 		return SMB_VFS_NEXT_FGETXATTR(
@@ -265,6 +302,9 @@ static int xattr_tdb_fsetxattr(struct vfs_handle_struct *handle,
 	if (!xattr_tdb_init(handle, &config)) {
 		return -1;
 	}
+	if (config->native_hfs) {
+		return tc_xattr_tdb_native_set(fsp, name, value, size, flags);
+	}
 
 	if (config->ignore_user_xattr && is_user_xattr(name)) {
 		return SMB_VFS_NEXT_FSETXATTR(
@@ -295,6 +335,9 @@ static ssize_t xattr_tdb_flistxattr(struct vfs_handle_struct *handle,
 	if (!xattr_tdb_init(handle, &config)) {
 		return -1;
 	}
+	if (config->native_hfs) {
+		return tc_xattr_tdb_native_list(fsp, list, size);
+	}
 
 	if (SMB_VFS_NEXT_FSTAT(handle, fsp, &sbuf) == -1) {
 		return -1;
@@ -333,6 +376,9 @@ static int xattr_tdb_fremovexattr(struct vfs_handle_struct *handle,
 	if (!xattr_tdb_init(handle, &config)) {
 		return -1;
 	}
+	if (config->native_hfs) {
+		return tc_xattr_tdb_native_remove(fsp, name);
+	}
 
 	if (config->ignore_user_xattr && is_user_xattr(name)) {
 		return SMB_VFS_NEXT_FREMOVEXATTR(handle, fsp, name);
@@ -383,6 +429,18 @@ static bool xattr_tdb_init(struct vfs_handle_struct *handle,
 		goto error;
 	}
 
+	/* Native HFS shares keep xattrs in the filesystem, not a database. */
+	config->native_hfs = tc_airport_path_is_hfs(
+		handle->conn->connectpath);
+	if (config->native_hfs) {
+		SMB_VFS_HANDLE_SET_DATA(handle, config, config_destructor,
+					struct xattr_tdb_config, return false);
+		if (_config != NULL) {
+			*_config = config;
+		}
+		return true;
+	}
+
 	def_dbname = state_path(talloc_tos(), "xattr.tdb");
 	if (def_dbname == NULL) {
 		errno = ENOSYS;
@@ -443,6 +501,9 @@ static int xattr_tdb_openat(struct vfs_handle_struct *handle,
 	if (!xattr_tdb_init(handle, &config)) {
 		return -1;
 	}
+	if (config->native_hfs) {
+		return SMB_VFS_NEXT_OPENAT(handle, dirfsp, smb_fname, fsp, how);
+	}
 
 	fd = SMB_VFS_NEXT_OPENAT(handle,
 				 dirfsp,
@@ -493,6 +554,9 @@ static int xattr_tdb_mkdirat(vfs_handle_struct *handle,
 	if (!xattr_tdb_init(handle, &config)) {
 		return -1;
 	}
+	if (config->native_hfs) {
+		return SMB_VFS_NEXT_MKDIRAT(handle, dirfsp, smb_fname, mode);
+	}
 
 	ret = SMB_VFS_NEXT_MKDIRAT(handle,
 				dirfsp,
@@ -539,6 +603,9 @@ static int xattr_tdb_unlinkat(vfs_handle_struct *handle,
 	if (!xattr_tdb_init(handle, &config)) {
 		return -1;
 	}
+	if (config->native_hfs) {
+		return SMB_VFS_NEXT_UNLINKAT(handle, dirfsp, smb_fname, flags);
+	}
 
 	frame = talloc_stackframe();
 
