diff --git a/source3/modules/util_reparse.c b/source3/modules/util_reparse.c
--- a/source3/modules/util_reparse.c
+++ b/source3/modules/util_reparse.c
@@ -187,6 +187,28 @@ static NTSTATUS fsctl_get_reparse_point_lnk(struct files_struct *fsp,
 		return status;
 	}
 
+	if (!fsp->fsp_flags.posix_open &&
+	    tc_native_links_enabled(fsp->conn)) {
+		/*
+		 * Non-POSIX clients (macOS and Windows) read the target in
+		 * their own namespace: names mapped as catia maps them (a
+		 * native "a:b" is "a<U+F022>b"; macOS maps them back with
+		 * UTF_SFM_CONVERSIONS, Windows would take ':' for a stream),
+		 * and '\\' separators they convert back themselves. Map the
+		 * names first: catia maps a literal '\\' in a name to U+F026.
+		 */
+		status = tc_native_links_map_target(
+			fsp->conn,
+			reparse,
+			&reparse->parsed.lnk.substitute_name,
+			vfs_translate_to_windows);
+		if (!NT_STATUS_IS_OK(status)) {
+			TALLOC_FREE(reparse);
+			return status;
+		}
+		string_replace(reparse->parsed.lnk.substitute_name, '/', '\\');
+	}
+
 	status = fsctl_get_reparse_point_int(
 		fsp, reparse, mem_ctx, _out_data, max_out_len, _out_len);
 	TALLOC_FREE(reparse);
