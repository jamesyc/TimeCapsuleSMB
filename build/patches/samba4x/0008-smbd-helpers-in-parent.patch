diff --git a/source3/smbd/server.c b/source3/smbd/server.c
--- a/source3/smbd/server.c
+++ b/source3/smbd/server.c
@@ -475,6 +475,16 @@ static bool smbd_notifyd_init(struct messaging_context *msg, bool interactive,
 	NTSTATUS status;
 	bool ok;
 
+#ifdef TC_SAMBA4X_APPLIANCE
+	/*
+	 * The appliance smbd forks no resident notifyd or cleanupd, to save
+	 * memory: they run in the parent's event loop, as for interactive
+	 * smbd. The scavenger is still forked: its expiry waits for
+	 * share-mode, byte-range and open-record locks that a stuck client
+	 * smbd can hold, and the parent must keep accepting connections.
+	 */
+	interactive = true;
+#endif
 	if (interactive) {
 		req = notifyd_req(msg, ev);
 		return (req != NULL);
@@ -661,6 +671,9 @@ static bool cleanupd_init(struct messaging_context *msg, bool interactive,
 	char c;
 	int up_pipe[2];
 
+#ifdef TC_SAMBA4X_APPLIANCE
+	interactive = true;	/* see smbd_notifyd_init() */
+#endif
 	if (interactive) {
 		req = smbd_cleanupd_send(msg, ev, msg, parent_id.pid);
 		*ppid = messaging_server_id(msg);
@@ -2654,9 +2667,18 @@ quic_disabled:
 		exit_daemon("Samba cannot init notification", EACCES);
 	}
 
+#ifdef TC_SAMBA4X_APPLIANCE
+	/*
+	 * The periodic datagram-socket sweep forks a helper each time it runs.
+	 * Skip it (see smbd_notifyd_init); cleanupd in the parent still removes
+	 * each exited child's socket, so the sweep would only catch leftovers.
+	 */
+	DBG_NOTICE("Skipping the periodic messaging dgm cleanup\n");
+#else
 	if (!messaging_parent_dgm_cleanup_init(msg_ctx)) {
 		exit(1);
 	}
+#endif
 
 	if (!smbd_scavenger_init(NULL, msg_ctx, ev_ctx)) {
 		exit_daemon("Samba cannot init scavenging", EACCES);
