+/*
+ * An smbd that dies without closing its files (a crash, an abort, a kill)
+ * leaves its open records with its server id, live as far as anyone can
+ * tell. Nothing indexes opens by owner, and cleanupd only rescans
+ * persistent handles, so they stay until smbd restarts: a reconnect finds
+ * such a record "not cleaned up" and refuses it, and the client opens the
+ * file again under a new record. After an unclean exit cleanupd asks
+ * for this walk (scavenger_rescan_request()); clean exits closed or
+ * disconnected their opens, so ordinary reconnects never trigger it.
+ * Disconnected opens are left to their timers, persistent ones to
+ * cleanup_ph().
+ */
+struct scavenger_rescan_rec {
+	struct scavenger_message msg;
+	struct server_id owner;
+};
+
+struct scavenger_rescan_state {
+	TALLOC_CTX *mem_ctx;
+	struct scavenger_rescan_rec *recs;
+};
+
+static int scavenger_rescan_fn(struct db_record *rec,
+			       struct smbXsrv_open_global *global,
+			       TDB_DATA *rc_open_global_key,
+			       void *private_data)
+{
+	struct scavenger_rescan_state *state = private_data;
+	size_t n = talloc_array_length(state->recs);
+	struct scavenger_rescan_rec *recs = NULL;
+
+	/*
+	 * Collect only: no system calls under the traverse's chain lock,
+	 * as cleanup_ph_fn().
+	 */
+	if (global == NULL || global->persistent ||
+	    server_id_is_disconnected(&global->server_id)) {
+		return 0;
+	}
+
+	recs = talloc_realloc(state->mem_ctx,
+			      state->recs,
+			      struct scavenger_rescan_rec,
+			      n + 1);
+	if (recs == NULL) {
+		DBG_ERR("talloc_realloc failed\n");
+		return -1;
+	}
+	recs[n] = (struct scavenger_rescan_rec) {
+		.msg = {
+			.file_id = global->file_id,
+			.open_persistent_id = global->open_persistent_id,
+			.name_hash = global->name_hash,
+		},
+		.owner = global->server_id,
+	};
+	state->recs = recs;
+	return 0;
+}
+
+/*
+ * Returns how many opens it removed: an owner that closed or disconnected
+ * its opens, then exited cleanly after the walk, left none to remove.
+ */
+static size_t scavenger_rescan(void)
+{
+	TALLOC_CTX *frame = talloc_stackframe();
+	struct scavenger_rescan_state state = { .mem_ctx = frame, };
+	size_t i, n, removed = 0;
+	NTSTATUS status;
+
+	status = smbXsrv_open_global_traverse(scavenger_rescan_fn, &state);
 	if (!NT_STATUS_IS_OK(status)) {
-		DBG_WARNING("Failed to cleanup open global for file %s open "
-			    "%"PRIu64": %s\n",
-			    file_id_str_buf(ctx->msg.file_id, &idbuf),
-			    ctx->msg.open_persistent_id,
-			    nt_errstr(status));
-		return;
+		DBG_ERR("smbXsrv_open_global_traverse failed: %s\n",
+			nt_errstr(status));
 	}
 
-	ok = share_mode_cleanup_disconnected(ctx->msg.file_id,
-					     ctx->msg.open_persistent_id,
-					     ctx->msg.name_hash);
-	if (!ok) {
-		DBG_WARNING("Failed to cleanup share modes and byte range "
-			    "locks for file %s open %"PRIu64"\n",
-			    file_id_str_buf(ctx->msg.file_id, &idbuf),
-			    ctx->msg.open_persistent_id);
+	n = talloc_array_length(state.recs);
+	for (i = 0; i < n; i++) {
+		if (serverid_exists(&state.recs[i].owner)) {
+			continue;
+		}
+		if (scavenger_cleanup(&state.recs[i].msg)) {
+			removed += 1;
+		}
 	}
 
+	if (removed != 0) {
+		DBG_ERR("removed %zu opens left by exited smbds\n", removed);
+	}
+	TALLOC_FREE(frame);
+	return removed;
+}
