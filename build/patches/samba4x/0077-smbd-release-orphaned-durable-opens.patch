+void scavenger_rescan_request(struct messaging_context *msg_ctx)
+{
+	NTSTATUS status;
+
+	if (smbd_scavenger_state == NULL) {
+		return;
+	}
+
+	/*
+	 * An empty MSG_SMB_SCAVENGER asks for scavenger_rescan(). The
+	 * parent forwards it like any other, starting a scavenger if none
+	 * runs. cleanupd may run in the parent itself; messaging delivers
+	 * to self, and scavenger_schedule_disconnected() would assert.
+	 */
+	status = messaging_send(msg_ctx,
+				smbd_scavenger_state->parent_id,
+				MSG_SMB_SCAVENGER,
+				&data_blob_null);
+	if (!NT_STATUS_IS_OK(status)) {
+		DBG_WARNING("messaging_send failed: %s\n", nt_errstr(status));
+	}
 }
 
