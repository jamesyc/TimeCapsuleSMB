+		if (NT_STATUS_EQUAL(status, NT_STATUS_FILE_NOT_AVAILABLE)) {
+			/*
+			 * The old smbd still holds this open: macOS reconnects
+			 * before the old smbd has finished tearing down the lost
+			 * connection, which can take over a minute on a slow disk. Defer
+			 * the create and retry every 150 ms until 90 s after it
+			 * arrived. Sleeping here instead would stop this smbd
+			 * reading its socket; its TCP window then closes, and
+			 * macOS answers that with short WRITEs (0072). Once the
+			 * 90 s run out, answer as upstream and MS-SMB2
+			 * 3.3.5.9.12 do for an open still attached to a session.
+			 */
+			if (!state->open_was_deferred) {
+				DBG_NOTICE("TIMECAPSULE_DURABLE_OPEN_LIVE_RETRY: "
+					   "%s is still attached to a live "
+					   "smbd; deferring for up to 90s\n",
+					   state->fname);
+			}
+			TALLOC_FREE(state->open_rec); /* the previous try's */
+			if (setup_poll_open(smb1req, NULL,
+					    tevent_timeval_set(90, 0),
+					    tevent_timeval_set(0, 150000))) {
+				return req;
+			}
+			status = NT_STATUS_OBJECT_NAME_NOT_FOUND;
+		}
