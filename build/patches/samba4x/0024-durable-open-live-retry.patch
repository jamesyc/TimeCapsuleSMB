 		}
 
-		SIVAL(p, 0, state->op->global->durable_timeout_msec);
+		SIVAL(p, 0, state->durable_v2_granted_msec);
 		SIVAL(p, 4, durable_v2_response_flags);
 
 		status = smb2_create_blob_add(state->out_context_blobs,
diff --git a/source3/smbd/smbXsrv_open.c b/source3/smbd/smbXsrv_open.c
--- a/source3/smbd/smbXsrv_open.c
+++ b/source3/smbd/smbXsrv_open.c
@@ -1294,10 +1294,20 @@ static void smb2srv_open_recreate_fn(
 	TDB_DATA key = dbwrap_record_get_key(rec);
 	struct smbXsrv_open_global *global = NULL;
 	struct GUID_txt_buf buf1, buf2;
+	bool live;
 
 	state->status = smbXsrv_open_global_verify_record(
 		key, oldval, state->op, &state->op->global);
-	if (!NT_STATUS_EQUAL(state->status, NT_STATUS_REMOTE_DISCONNECT)) {
+	/*
+	 * Time Machine can reconnect quickly enough that the new SMB2
+	 * durable-open recreate reaches this path before the old smbd has
+	 * marked the open record disconnected. Check that live record like a
+	 * disconnected one, then report only the same durable open as
+	 * transiently busy below; never hand out a second live handle.
+	 */
+	live = NT_STATUS_EQUAL(state->status, NT_STATUS_OBJECTID_EXISTS);
+	if (!live &&
+	    !NT_STATUS_EQUAL(state->status, NT_STATUS_REMOTE_DISCONNECT)) {
 		DBG_WARNING("smbXsrv_open_global_verify_record for %s "
 			    "failed: %s\n",
 			    tdb_data_dbg(key),
@@ -1349,6 +1359,21 @@ static void smb2srv_open_recreate_fn(
 		goto not_found;
 	}
 
+	if (live) {
+		/*
+		 * NT_STATUS_FILE_NOT_AVAILABLE is only the caller's "still
+		 * busy, retry" signal; the client never sees it (see
+		 * smbd_smb2_create_send).
+		 */
+		DBG_DEBUG("TIMECAPSULE_DURABLE_OPEN_LIVE_RETRY: "
+			  "open %s is still attached to a live smbd; "
+			  "treating matching durable reconnect as transiently "
+			  "unavailable\n",
+			  tdb_data_dbg(key));
+		state->status = NT_STATUS_FILE_NOT_AVAILABLE;
+		return;
+	}
+
 	global->open_volatile_id = state->op->local_id;
 	global->server_id = state->me;
 	global->session_global_id = state->session->global->session_global_id;
