 	}
 
+	if (live) {
+		/*
+		 * NT_STATUS_FILE_NOT_AVAILABLE is only the caller's "still
+		 * busy, retry" signal; the client never sees it (see
+		 * smbd_smb2_create_send).
+		 */
+		DBG_DEBUG("TIMECAPSULE_DURABLE_OPEN_LIVE_RETRY: "
+			  "open %s is still attached to a live smbd; "
