+	bool live;
 
 	state->status = smbXsrv_open_global_verify_record(
 		key, oldval, state->op, &state->op->global);
-	if (!NT_STATUS_EQUAL(state->status, NT_STATUS_REMOTE_DISCONNECT)) {
+	/*
+	 * Time Machine can reconnect quickly enough that the new SMB2
+	 * durable-open recreate reaches this path before the old smbd has
+	 * marked the open record disconnected. Check that live record like a
+	 * disconnected one, then report only the same durable open as
+	 * transiently busy below; never hand out a second live handle.
+	 */
+	live = NT_STATUS_EQUAL(state->status, NT_STATUS_OBJECTID_EXISTS);
+	if (!live &&
+	    !NT_STATUS_EQUAL(state->status, NT_STATUS_REMOTE_DISCONNECT)) {
 		DBG_WARNING("smbXsrv_open_global_verify_record for %s "
 			    "failed: %s\n",
