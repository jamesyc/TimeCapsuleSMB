+		if (NT_STATUS_EQUAL(status, NT_STATUS_FILE_NOT_AVAILABLE)) {
+			/*
+			 * The old smbd still holds this open: macOS reconnects
+			 * before the old smbd has finished tearing down the lost
+			 * connection, which can take over a minute on a slow disk. Defer
+			 * the create and retry every 150 ms until 90 s after it
+			 * arrived. Sleeping here instead would stop this smbd
+			 * reading its socket; its TCP window then closes, and
+			 * macOS answers that with short WRITEs (0072). Once the
+			 * 90 s run out, answer as upstream and MS-SMB2
+			 * 3.3.5.9.12 do for an open still attached to a session.
+			 */
+			if (!state->open_was_deferred) {
+				DBG_NOTICE("TIMECAPSULE_DURABLE_OPEN_LIVE_RETRY: "
+					   "%s is still attached to a live "
+					   "smbd; deferring for up to 90s\n",
+					   state->fname);
+			}
+			TALLOC_FREE(state->open_rec); /* the previous try's */
+			if (setup_poll_open(smb1req, NULL,
+					    tevent_timeval_set(90, 0),
+					    tevent_timeval_set(0, 150000))) {
+				return req;
+			}
+			status = NT_STATUS_OBJECT_NAME_NOT_FOUND;
+		}
 		if (tevent_req_nterror(req, status)) {
 			DBG_NOTICE("smb2srv_open_recreate failed: %s\n",
 				   nt_errstr(status));
@@ -1488,6 +1515,16 @@ static void smbd_smb2_cc_before_exec_dhc2q(struct tevent_req *req)
 		 */
 		state->durable_timeout_msec = (60*1000);
 	}
+	/*
+	 * Grant that timeout: macOS refuses Time Machine's reconnect
+	 * timeout setting with E2BIG unless the reply carries exactly the
+	 * value it asked for, and never uses the grant to decide a
+	 * reconnect. Keep the handle 300 s whatever was granted: slow HFS
+	 * teardown releases handles one by one, and the earlier ones must
+	 * outlive the client's wait for later durable reopens.
+	 */
+	state->durable_v2_granted_msec = state->durable_timeout_msec;
+	state->durable_timeout_msec = 300 * 1000;
 
 	if ((durable_v2_flags & SMB2_DHANDLE_FLAG_PERSISTENT) &&
 	    (server_caps & SMB2_CAP_PERSISTENT_HANDLES) &&
@@ -1989,7 +2026,7 @@ static void smbd_smb2_create_after_exec(struct tevent_req *req)
